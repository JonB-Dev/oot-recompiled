// Generated by CMake from src/setup/setup.rc.in. Do not edit the generated copy.
//
// The setup file's icon is the same mark the game carries, so the downloaded file looks like the
// thing it installs.
1 ICON "@ICON_PATH@"

// Resource 100 is the PAYLOAD: a zip holding the game executable, the three DLLs and assets\.
// src/setup/setup.cpp writes it into the user's application data and starts the game.
100 RCDATA "@PAYLOAD_PATH@"
