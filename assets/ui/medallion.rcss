/* GENERATED by tools/medallion.py from the design decision's numbers. Do not edit by hand:
 * change the tool and run it. The Leaf fan medallion as stacked layers on one 200 by 190
 * canvas: the ground and leaf shadows, ten leaves, the rim (gold, or lime when selected), the
 * glint, the glyph. Selected (.is-f on any ancestor), each side's fan breathes open and a glint
 * runs round the rim (design/medallion/DESIGN-DECISION.md). */

.md { position: relative; display: inline-block; width: var(--md-size); height: var(--md-height); }
.md .ly { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.md .ly.shadows { decorator: svg(medallion/shadows.svg); }
.md .ly.rim { decorator: svg(medallion/rim-gold.svg); }
.is-f .md .ly.rim, .md.is-f .ly.rim { decorator: svg(medallion/rim-lime.svg); }
.md .ly.glint { decorator: svg(medallion/glint.svg); opacity: 0; transform-origin: 50% 47.4%; }
.md .glyph { position: absolute; left: 38.6%; top: 35.5%; width: 22.8%; height: 24%; image-color: var(--md-glyph); }
.is-f .md .glyph, .md.is-f .glyph { image-color: var(--md-glyph-on); }
.md .ly.leaf-l-o1 { decorator: svg(medallion/leaf-l-o1.svg); transform-origin: 23.7% 37.3%; }
.md .ly.leaf-l-o2 { decorator: svg(medallion/leaf-l-o2.svg); transform-origin: 35.2% 72.4%; }
.md .ly.leaf-l-i1 { decorator: svg(medallion/leaf-l-i1.svg); transform-origin: 25% 47.4%; }
.md .ly.leaf-l-i2 { decorator: svg(medallion/leaf-l-i2.svg); transform-origin: 30.6% 63.9%; }
.md .ly.leaf-l-c { decorator: svg(medallion/leaf-l-c.svg); transform-origin: 28.2% 55.3%; }
.md .ly.leaf-r-o1 { decorator: svg(medallion/leaf-r-o1.svg); transform-origin: 76.3% 37.3%; }
.md .ly.leaf-r-o2 { decorator: svg(medallion/leaf-r-o2.svg); transform-origin: 64.9% 72.4%; }
.md .ly.leaf-r-i1 { decorator: svg(medallion/leaf-r-i1.svg); transform-origin: 75% 47.4%; }
.md .ly.leaf-r-i2 { decorator: svg(medallion/leaf-r-i2.svg); transform-origin: 69.5% 63.9%; }
.md .ly.leaf-r-c { decorator: svg(medallion/leaf-r-c.svg); transform-origin: 71.8% 55.3%; }
.is-f .md .ly.leaf-l-o1, .md.is-f .ly.leaf-l-o1 { animation: var(--fan-cycle) var(--ease) infinite fan-l; }
.is-f .md .ly.leaf-l-o2, .md.is-f .ly.leaf-l-o2 { animation: var(--fan-cycle) var(--ease) infinite fan-l; }
.is-f .md .ly.leaf-l-i1, .md.is-f .ly.leaf-l-i1 { animation: var(--fan-cycle) var(--fan-step) var(--ease) infinite fan-l; }
.is-f .md .ly.leaf-l-i2, .md.is-f .ly.leaf-l-i2 { animation: var(--fan-cycle) var(--fan-step) var(--ease) infinite fan-l; }
.is-f .md .ly.leaf-l-c, .md.is-f .ly.leaf-l-c { animation: var(--fan-cycle) var(--fan-step-2) var(--ease) infinite fan-l; }
.is-f .md .ly.leaf-r-o1, .md.is-f .ly.leaf-r-o1 { animation: var(--fan-cycle) var(--ease) infinite fan-r; }
.is-f .md .ly.leaf-r-o2, .md.is-f .ly.leaf-r-o2 { animation: var(--fan-cycle) var(--ease) infinite fan-r; }
.is-f .md .ly.leaf-r-i1, .md.is-f .ly.leaf-r-i1 { animation: var(--fan-cycle) var(--fan-step) var(--ease) infinite fan-r; }
.is-f .md .ly.leaf-r-i2, .md.is-f .ly.leaf-r-i2 { animation: var(--fan-cycle) var(--fan-step) var(--ease) infinite fan-r; }
.is-f .md .ly.leaf-r-c, .md.is-f .ly.leaf-r-c { animation: var(--fan-cycle) var(--fan-step-2) var(--ease) infinite fan-r; }
.is-f .md .ly.glint, .md.is-f .ly.glint { animation: var(--glint-cycle) var(--ease) infinite glint; }
.is-fading .md .ly.glint { visibility: hidden; }
@keyframes fan-r { 0% { transform: rotate(0deg); } 50% { transform: rotate(5deg); } 100% { transform: rotate(0deg); } }
@keyframes fan-l { 0% { transform: rotate(0deg); } 50% { transform: rotate(-5deg); } 100% { transform: rotate(0deg); } }
@keyframes glint { 0% { opacity: 0; transform: rotate(-40deg); } 30% { opacity: 0.85; } 60% { opacity: 0.85; } 100% { opacity: 0; transform: rotate(250deg); } }
