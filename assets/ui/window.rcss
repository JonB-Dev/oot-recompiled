/* The launcher as its own window (play milestone): the case IS the window, edge to edge, with
 * our own chrome in its lid: the mark and the title at the left, minimize and close at the
 * right. The window itself is borderless (main/launch.cpp shapes it and makes the lid's band
 * draggable), so everything the user sees is drawn here in the case's own tokens. Tokens only,
 * as every component sheet.
 */

.frame
{
	width: 100%;
	height: 100%;
}

.case.window
{
	width: 100%;
	height: 100%;
	max-height: 100%;
	border-radius: 0;
	border-color: var(--color-lime);
}

/* The game window's frame (frame.rml): the same brass edge around the window, and the header
 * as a bar across the top, the launcher's lid riding over the picture while the pointer is
 * there. Both are hidden by the shell the rest of the time. */
.frame-edge
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	border: var(--rule) var(--color-lime);
	box-sizing: border-box;
}

.frame-bar
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: var(--chrome-bar);
	box-sizing: border-box;
	padding: 0 var(--space-3);
	display: flex;
	align-items: center;
	justify-content: space-between;
	decorator: vertical-gradient(var(--color-slate-raised) var(--color-slate));
	border-bottom: var(--rule) var(--color-lime);
}

/* A title bar's proportions: the title in the caption size, the mark smaller than the launcher's
 * lid. THE BUTTONS ARE NOT LISTED HERE ANY MORE and that is the point: they are one size, defined
 * once in tokens.rcss, and both bars use it.
 *
 * They used to differ, 32dp in the launcher against 22dp here, and the difference outlived the
 * reason for it. Matching only the GLYPHS (the fix before this one) left a 10dp glyph sitting in
 * a 32dp button in the launcher and a 22dp one in the game, so the launcher's controls read as
 * small and widely spaced: "you essentially reversed the issue. the launcher pre-game now has
 * the problem". The user's instruction settles which one wins: "make them both the same exact
 * size as the now in-game window bar". */
.frame-bar .title
{
	font-size: var(--size-label);
}

.frame-bar .mark
{
	width: var(--mark-small-w);
	height: var(--mark-small-h);
	margin-right: var(--space-2);
}

.frame-edge.hidden,
.frame-bar.hidden
{
	display: none;
}

.chrome
{
	display: flex;
	align-items: center;
}

.win-btn
{
	width: var(--win-btn);
	height: var(--win-btn);
	margin-left: var(--rule);
	display: flex;
	align-items: center;
	justify-content: center;
	font-family: var(--font-display);
	font-size: var(--size-heading);
	color: var(--color-dim);
	border-radius: var(--radius);
	transition: background-color var(--duration-fast) var(--ease),
	            color var(--duration-fast) var(--ease);
}

.win-btn:hover
{
	color: var(--color-ink);
	background-color: var(--color-accent-wash);
}

/* THE BUTTONS' ICONS ARE THE LAUNCHER'S OWN: minus, square and x from icons/ (Lucide, in the
 * licenses manifest), one rule for both bars; shell.rml links this sheet for it. They used to be
 * drawn here from one-pixel boxes, and a stroke that thin has nowhere safe to land below 100%. As
 * filled boxes, RmlUi rounded the minimize bar and the cross to no pixels at all in the game bar
 * ("the app is missing minimize and close icons but only while its in the smaller dropdown
 * titlebar not in the laucnher"); as borders, the cross's two rotated bars rasterized differently
 * from each other, one arm thick and whole, the other thin and broken ("looks distorted now").
 * Nudging the bars into line at one size breaks at the next. An icon is drawn smooth at whatever
 * size its box comes out, the same in both directions. The button around it stays the bar's slim
 * --win-btn, so the window's hit test (main/launch.cpp) is unchanged. */
.win-ic
{
	width: var(--space-4);
	height: var(--space-4);
	image-color: var(--color-dim);
}

.win-btn:hover .win-ic
{
	image-color: var(--color-ink);
}
