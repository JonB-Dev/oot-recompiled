<rml>
<head>
    <title>Frame</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body class="overlay">
    <!-- The game window's own frame (play milestone): a brass edge around the window, and the
         header, the launcher's lid, riding over the picture when the pointer is at the top of
         the window. The shell shows and hides the two; the window itself has no border of the
         system's. -->
    <div class="frame-edge hidden" id="frame-edge"></div>
    <div class="frame-bar hidden" id="frame-bar">
        <div class="head">
            <div class="mark"></div>
            <div class="title">OoT: Recompiled</div>
        </div>
        <div class="chrome">
            <div class="win-btn" id="win-min"><div class="glyph-min"></div></div>
            <div class="win-btn" id="win-max"><div class="glyph-max"></div></div>
            <div class="win-btn" id="win-close"><div class="glyph-x"><div class="bar a"></div><div class="bar b"></div></div></div>
        </div>
    </div>
</body>
</rml>
