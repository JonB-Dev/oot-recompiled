# Files whose exact bytes are checked by a hash (assets/licenses/MANIFEST.txt, phase 85 of the
# menus plan) or regenerated byte for byte by a tool (tools/medallion.py --check). With
# core.autocrlf on, git would rewrite their line endings on checkout and every hash would fail on
# a fresh clone, so they are stored and checked out exactly as they are.
assets/fonts/** -text
assets/icons/** -text
assets/licenses/** -text
assets/ui/medallion/** -text
assets/ui/medallion.rcss -text
assets/ui/textures/** -text
assets/ui/brand/** -text
assets/ui/prompts/** -text
