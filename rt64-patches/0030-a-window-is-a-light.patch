+    // THE BRIGHT LATTICES, BY HASH (patch 0030): the textures that are glass crossed by dark lines.
+    // Kept apart from the alpha kinds so neither answer changes the other.
+    static std::mutex textureLatticeMutex;
+    static std::unordered_map<uint64_t, bool> textureLattices;
+
+    bool textureIsBrightLattice(uint64_t hash) {
+        std::scoped_lock lock(textureLatticeMutex);
+        const auto it = textureLattices.find(hash);
+        return (it != textureLattices.end()) && it->second;
+    }
+
+    // Bright on average and high in contrast throughout: the mean brightness at least 0.6 and its
+    // spread at least 0.25. The measure comes from the Temple of Time, whose lattice glass reads
+    // 0.71 and 0.33 while its wall and pillar stone, as bright, spreads only about 0.1. A checkered
+    // floor passes too; the renderer takes only upright surfaces as windows. Reads texture memory
+    // the way classifyTextureAlpha does; a paletted texture or a format it does not read is never
+    // a lattice.
+    static bool classifyTextureLattice(const uint8_t *TMEM, int width, int height, uint32_t tlut, const LoadTile &loadTile) {
+        if ((width <= 0) || (height <= 0) || (width > 1024) || (height > 1024) || (tlut > 0)) {
+            return false;
+        }
+
+        const bool RGBA32 = (loadTile.siz == G_IM_SIZ_32b) && (loadTile.fmt == G_IM_FMT_RGBA);
+        const uint32_t tmemMask = RGBA32 ? 2047U : 4095U;
+        const uint32_t rowBytes = uint32_t(loadTile.line) << 3;
+        const uint32_t base = uint32_t(loadTile.tmem) << 3;
+        auto byteAt = [&](uint32_t row, uint32_t offset, uint32_t half) -> uint8_t {
+            uint32_t address = (base + row * rowBytes + offset) & tmemMask;
+            if (row & 1) {
+                address ^= 4;
+            }
+
+            return TMEM[(address & tmemMask) | half];
+        };
+
+        double sum = 0.0;
+        double sumSquares = 0.0;
+        for (uint32_t y = 0; y < uint32_t(height); y++) {
+            for (uint32_t x = 0; x < uint32_t(width); x++) {
+                float luminance = 0.0f;
+                if ((loadTile.siz == G_IM_SIZ_16b) && (loadTile.fmt == G_IM_FMT_RGBA)) {
+                    const uint32_t high = byteAt(y, x * 2, 0);
+                    const uint32_t low = byteAt(y, x * 2 + 1, 0);
+                    const float r = float(high >> 3) / 31.0f;
+                    const float g = float(((high & 7U) << 2) | (low >> 6)) / 31.0f;
+                    const float b = float((low >> 1) & 31U) / 31.0f;
+                    luminance = 0.299f * r + 0.587f * g + 0.114f * b;
+                }
+                else if (RGBA32) {
+                    const float r = float(byteAt(y, x * 2, 0)) / 255.0f;
+                    const float g = float(byteAt(y, x * 2 + 1, 0)) / 255.0f;
+                    const float b = float(byteAt(y, x * 2, 2048U)) / 255.0f;
+                    luminance = 0.299f * r + 0.587f * g + 0.114f * b;
+                }
+                else if ((loadTile.siz == G_IM_SIZ_16b) && (loadTile.fmt == G_IM_FMT_IA)) {
+                    luminance = float(byteAt(y, x * 2, 0)) / 255.0f;
+                }
+                else if ((loadTile.siz == G_IM_SIZ_8b) && (loadTile.fmt == G_IM_FMT_IA)) {
+                    luminance = float(byteAt(y, x, 0) >> 4) / 15.0f;
+                }
+                else if ((loadTile.siz == G_IM_SIZ_8b) && (loadTile.fmt == G_IM_FMT_I)) {
+                    luminance = float(byteAt(y, x, 0)) / 255.0f;
+                }
+                else {
+                    return false;
+                }
+
+                sum += luminance;
+                sumSquares += double(luminance) * double(luminance);
+            }
+        }
+
+        const double count = double(width) * double(height);
+        const double mean = sum / count;
+        const double spread = std::sqrt(std::max(sumSquares / count - mean * mean, 0.0));
+        return (mean >= 0.6) && (spread >= 0.25);
+    }
