+    // A LATTICE WINDOW IS A LIGHT (patch 0030). The Temple of Time's windows are glass painted on
+    // its walls, not openings, so no traced sun can come through them, and the hall below them was
+    // lit as though they were stone (the user, 2026-10-08: "the windows in the Temple of Time ...
+    // to be actual light sources that cast shadows per window across the room"). Where the game
+    // says a place's windows give light (RaytracingEnvironment::windowLights), each upright, flat
+    // draw of a bright lattice texture (textureIsBrightLattice) becomes daylight falling into the
+    // room through that rectangle: inward and down at a fixed slope, lighting only what the window
+    // can see along it, with shadow rays back out through the glass, so every pillar casts its own
+    // shadow from every window. Inward is the side the eye is on, because the windows are seen
+    // from inside.
+    static const float WindowMinSize = 60.0f;          // world units across, each way
+    static const float WindowMaxTilt = 0.25f;          // how far from upright its plane may lean (the normal's up share)
+    static const float WindowFlatness = 0.02f;         // the variance off its plane against the smaller one in it
+    static const float WindowLightDrop = 0.8f;         // the downward share of the light's direction: about 53 degrees below level
+    static const float WindowReach = 3000.0f;          // world units the light travels from the glass
+    static const float WindowStrength = 0.9f;
+    static const uint32_t WindowLightBit = 16u;        // the group bit the shaders read as a window (Raytracing.hlsl)
+
+    // The distinct world positions of a draw's vertices, as beamFromDraw reads them.
+    static uint32_t drawWorldPoints(const DrawData &drawData, const GameCall &call, hlslpp::float3 *points, uint32_t maxPoints) {
+        const uint32_t triangleCount = call.callDesc.triangleCount;
+        const uint32_t start = call.meshDesc.faceIndicesStart;
+        if ((start + triangleCount * 3) > drawData.faceIndices.size()) {
+            return 0;
+        }
+
+        uint32_t indices[MaxBeamTriangles * 3];
+        uint32_t count = 0;
+        for (uint32_t i = 0; (i < (triangleCount * 3)) && (count < maxPoints) && (count < (MaxBeamTriangles * 3)); i++) {
+            const uint32_t v = drawData.faceIndices[start + i];
+            if (std::find(indices, indices + count, v) == (indices + count)) {
+                indices[count++] = v;
+            }
+        }
+
+        for (uint32_t i = 0; i < count; i++) {
+            const uint32_t v = indices[i];
+            if ((v >= drawData.worldIndices.size()) || (((v + 1) * 3) > drawData.posFloats.size())) {
+                return 0;
+            }
+
+            const uint16_t transformIndex = drawData.worldIndices[v];
+            if (transformIndex >= drawData.worldTransforms.size()) {
+                return 0;
+            }
+
+            const hlslpp::float4 local(drawData.posFloats[v * 3 + 0], drawData.posFloats[v * 3 + 1], drawData.posFloats[v * 3 + 2], 1.0f);
+            const hlslpp::float4x4 worldMatrix = drawData.worldTransforms[transformIndex];
+            const hlslpp::float4 world = hlslpp::mul(local, worldMatrix);
+            points[i] = world.xyz;
+        }
+
+        return count;
+    }
+
+    static bool windowFromDraw(const DrawData &drawData, const GameCall &call, const hlslpp::float3 &eye, interop::PointLight &window) {
+        if ((call.callDesc.triangleCount < 1) || (call.callDesc.triangleCount > 16)) {
+            return false;
+        }
+
+        hlslpp::float3 points[48];
+        const uint32_t count = drawWorldPoints(drawData, call, points, 48);
+        if (count < 3) {
+            return false;
+        }
+
+        hlslpp::float3 mean(0.0f, 0.0f, 0.0f);
+        for (uint32_t i = 0; i < count; i++) {
+            mean += points[i];
+        }
+        mean /= float(count);
+
+        float covariance[3][3] = {};
+        for (uint32_t i = 0; i < count; i++) {
+            const hlslpp::float3 d = points[i] - mean;
+            const float dx = float(d.x);
+            const float dy = float(d.y);
+            const float dz = float(d.z);
+            covariance[0][0] += dx * dx; covariance[0][1] += dx * dy; covariance[0][2] += dx * dz;
+            covariance[1][1] += dy * dy; covariance[1][2] += dy * dz; covariance[2][2] += dz * dz;
+        }
+        covariance[1][0] = covariance[0][1];
+        covariance[2][0] = covariance[0][2];
+        covariance[2][1] = covariance[1][2];
+
+        float values[3];
+        float vectors[3][3];
+        symmetricEigen3(covariance, values, vectors);
+        if ((values[1] <= 0.0f) || (values[2] > (WindowFlatness * values[1]))) {
+            return false;
+        }
+
+        // The plane's normal, made level and turned to the side the eye is on.
+        hlslpp::float3 normal(vectors[0][2], vectors[1][2], vectors[2][2]);
+        if (std::abs(float(normal.y)) > WindowMaxTilt) {
+            return false;
+        }
+
+        normal = hlslpp::float3(float(normal.x), 0.0f, float(normal.z));
+        if (float(hlslpp::length(normal)) < 1e-4f) {
+            return false;
+        }
+
+        normal = hlslpp::normalize(normal);
+        if (float(hlslpp::dot(eye - mean, normal)) < 0.0f) {
+            normal = -normal;
+        }
+
+        const hlslpp::float3 up(0.0f, 1.0f, 0.0f);
+        const hlslpp::float3 across = hlslpp::normalize(hlslpp::cross(up, normal));
+        float acrossMin = 1e30f, acrossMax = -1e30f, upMin = 1e30f, upMax = -1e30f;
+        for (uint32_t i = 0; i < count; i++) {
+            const hlslpp::float3 d = points[i] - mean;
+            const float a = float(hlslpp::dot(d, across));
+            const float u = float(d.y);
+            acrossMin = std::min(acrossMin, a);
+            acrossMax = std::max(acrossMax, a);
+            upMin = std::min(upMin, u);
+            upMax = std::max(upMax, u);
+        }
+
+        if (((acrossMax - acrossMin) < WindowMinSize) || ((upMax - upMin) < WindowMinSize)) {
+            return false;
+        }
+
+        const hlslpp::float3 center = mean + across * (0.5f * (acrossMin + acrossMax)) + up * (0.5f * (upMin + upMax));
+        const float level = std::sqrt(1.0f - WindowLightDrop * WindowLightDrop);
+        const hlslpp::float3 falls = hlslpp::normalize(normal * level - up * WindowLightDrop);
+
+        window = {};
+        window.position = interop::float3(center);
+        window.direction = interop::float3(falls);
+        // Daylight through white glass, a touch warm.
+        window.diffuseColor = interop::float3(hlslpp::float3(1.0f, 0.96f, 0.88f) * WindowStrength);
+        // The fields a window uses, named for a point light's: the glass's inward normal in the
+        // specular color, its half width and half height in the point radius and the spot's
+        // maximum, how far its light travels in the exponent.
+        window.specularColor = interop::float3(normal);
+        window.pointRadius = 0.5f * (acrossMax - acrossMin);
+        window.spotMaxCosine = 0.5f * (upMax - upMin);
+        window.spotFalloffCosine = 0.0f;
+        window.attenuationExponent = WindowReach;
+        window.attenuationRadius = WindowReach;
+        window.shadowOffset = 0.0f;
+        window.flickerIntensity = 0.0f;
+        window.groupBits = WindowLightBit | 4u;
+        return true;
+    }
