+// A WINDOW (patch 0030): daylight falling into a room through a rectangle of glass the game
+// paints on its wall, found on the CPU (rt64_framebuffer_renderer.cpp, windowFromDraw). Its
+// fields, named for a point light's: position the middle of the glass, direction the way the
+// light falls (inward and down), the glass's inward normal in the specular color, its half width
+// and half height in the point radius and the spot's maximum, its reach in the exponent. A
+// surface is lit where the light, followed back up its direction, comes through the glass; its
+// shadow rays go back out the same way, so a pillar between a window and the floor shadows the
+// floor in the window's own shape.
+static const uint WindowLightBit = 16u;
+static const float WindowClearance = 12.0f;   // world units before the glass the shadow rays stop, so the wall the glass is painted on cannot block it
+static const float WindowEdge = 0.02f;        // the edge of a window's light softens by this share of the distance it fell
+static const float WindowSpread = 0.015f;     // how far its shadow rays lean, so its shadows soften with distance
+
+void windowLight(PointLight light, float3 position, float3 normal, float biasBase, uint2 launchIndex, uint lightIndex, uint lightSamples,
+                 inout float3 sum, inout float3 sumUnblocked) {
+    const float3 falls = light.direction;
+    const float3 inward = light.specularColor;
+    const float inside = dot(position - light.position, inward);
+    if (inside <= 0.0f) {
+        return;
+    }
+
+    // Back up the light to the plane of the glass.
+    const float approach = dot(falls, inward);
+    if (approach <= 0.0f) {
+        return;
+    }
+
+    const float travel = inside / approach;
+    if (travel >= light.attenuationExponent) {
+        return;
+    }
+
+    const float3 onGlass = position - falls * travel;
+    const float3 across = normalize(cross(float3(0.0f, 1.0f, 0.0f), inward));
+    const float3 offset = onGlass - light.position;
+    const float edge = WindowEdge * travel + 2.0f;
+    const float acrossShare = 1.0f - smoothstep(light.pointRadius - edge, light.pointRadius + edge, abs(dot(offset, across)));
+    const float upShare = 1.0f - smoothstep(light.spotMaxCosine - edge, light.spotMaxCosine + edge, abs(offset.y));
+    const float3 toLight = -falls;
+    const float ndl = saturate(dot(normal, toLight));
+    const float fade = 1.0f - smoothstep(light.attenuationExponent * 0.7f, light.attenuationExponent, travel);
+    const float weight = acrossShare * upShare * ndl * fade;
+    if (weight <= 0.0f) {
+        return;
+    }
+
+    float3 tangent;
+    float3 bitangent;
+    tangentFrame(toLight, tangent, bitangent);
+    const float3 shadowOrigin = position + normal * (biasBase * (1.0f + 2.0f / max(ndl, 0.25f)));
+    const float tMax = max(travel - WindowClearance, 0.0f);
+    float hitDistance;
+    float blocked = 0.0f;
+    for (uint ls = 0; ls < lightSamples; ls++) {
+        const float3 noise = getBlueNoise(gBlueNoise, launchIndex, FrParams.frameCount + 17u + ls * 31u + lightIndex * 7u);
+        const float angle = 6.28318531f * noise.x;
+        const float spread = sqrt(noise.y) * WindowSpread;
+        const float3 rayDirection = normalize(toLight + tangent * (spread * cos(angle)) + bitangent * (spread * sin(angle)));
+        const float sample = (tMax > LocalBlockerSkip)
+            ? traceVisibilityRange(shadowOrigin, rayDirection, LocalBlockerSkip, tMax, hitDistance)
+            : 1.0f;
+        blocked += 1.0f - sample;
+    }
+
+    const float visibility = 1.0f - (blocked / float(lightSamples));
+    sum += light.diffuseColor * (weight * visibility);
+    sumUnblocked += light.diffuseColor * weight;
+}
