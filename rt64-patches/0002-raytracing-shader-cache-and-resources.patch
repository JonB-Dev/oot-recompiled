diff --git a/src/render/rt64_raytracing_bluenoise.cpp b/src/render/rt64_raytracing_bluenoise.cpp
new file mode 100644
index 0000000..93906b7
--- /dev/null
+++ b/src/render/rt64_raytracing_bluenoise.cpp
@@ -0,0 +1,44 @@
+//
+// RT64, the renderer's patch series (OoT: Recompiled), patch 0002.
+//
+
+#include "rt64_raytracing_bluenoise.h"
+
+#include <cmath>
+
+namespace RT64 {
+    // Interleaved gradient noise (Jimenez), with the slice index folded into the x term so every
+    // slice differs. A placeholder for the blue noise table phase 54 brings; see the header.
+    static float gradientNoise(float x, float y, float slice) {
+        const float shifted = x + 5.588238f * slice;
+        const float inner = 0.06711056f * shifted + 0.00583715f * y;
+        const float f = 52.9829189f * (inner - std::floor(inner));
+        return f - std::floor(f);
+    }
+
+    const std::vector<uint8_t> &RaytracingBlueNoise::atlasBGRA8() {
+        static const std::vector<uint8_t> atlas = [] {
+            std::vector<uint8_t> bytes(AtlasWidth * AtlasHeight * 4);
+            for (uint32_t y = 0; y < AtlasHeight; y++) {
+                for (uint32_t x = 0; x < AtlasWidth; x++) {
+                    const uint32_t slice = (y / SliceSize) * SlicesPerRow + (x / SliceSize);
+                    const float px = float(x % SliceSize);
+                    const float py = float(y % SliceSize);
+                    const size_t at = (size_t(y) * AtlasWidth + x) * 4;
+                    for (uint32_t channel = 0; channel < 3; channel++) {
+                        // Each channel is its own slice of the sequence, so the three read as
+                        // three independent tables rather than one repeated.
+                        const float value = gradientNoise(px, py, float(slice * 3 + channel));
+                        bytes[at + (2 - channel)] = uint8_t(value * 255.0f + 0.5f);
+                    }
+
+                    bytes[at + 3] = 255;
+                }
+            }
+
+            return bytes;
+        }();
+
+        return atlas;
+    }
+};
diff --git a/src/render/rt64_raytracing_bluenoise.h b/src/render/rt64_raytracing_bluenoise.h
new file mode 100644
index 0000000..b97faa4
--- /dev/null
+++ b/src/render/rt64_raytracing_bluenoise.h
@@ -0,0 +1,31 @@
+//
+// RT64, the renderer's patch series (OoT: Recompiled), patch 0002.
+//
+// The blue noise the ray tracing path samples for its dither and its sample offsets. The pinned
+// renderer uploaded a 512 by 512 atlas from a generated header that is not in the tree; this
+// generates an atlas of the same shape at startup instead (64 slices of 64 by 64, laid out 8 by
+// 8, BGRA8), so no patch carries a megabyte of bytes.
+//
+// PLACEHOLDER UNTIL PHASE 54. The table is interleaved gradient noise with a per slice offset:
+// decorrelated and deterministic, not a true blue noise spectrum. Nothing reads it until the
+// shadow pass exists, and that phase replaces the generator with a proper blue noise table
+// (void and cluster, generated offline into a committed asset of ours). This file exists so the
+// path builds and the upload at setup has bytes to upload.
+//
+
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace RT64 {
+    struct RaytracingBlueNoise {
+        static const uint32_t SliceSize = 64;
+        static const uint32_t SlicesPerRow = 8;
+        static const uint32_t AtlasWidth = SliceSize * SlicesPerRow;
+        static const uint32_t AtlasHeight = SliceSize * SlicesPerRow;
+
+        // The atlas, generated once on first use. AtlasWidth * AtlasHeight * 4 bytes, BGRA8.
+        static const std::vector<uint8_t> &atlasBGRA8();
+    };
+};
