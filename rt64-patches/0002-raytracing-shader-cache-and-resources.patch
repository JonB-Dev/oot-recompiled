+//
+// RT64, the renderer's patch series (OoT: Recompiled), patch 0002.
+//
+// Every method is a no-op and creates nothing. See the header for which patch fills each in.
+//
+
+#include "rt64_raytracing_resources.h"
+
+namespace RT64 {
+    RaytracingResources::RaytracingResources(RenderWorker *worker, UserConfiguration::GraphicsAPI graphicsAPI) {
+        this->worker = worker;
+        this->graphicsAPI = graphicsAPI;
+    }
+
+    RaytracingResources::~RaytracingResources() { }
+
+    Upscaler *RaytracingResources::getUpscaler(UpscaleMode mode) {
+        (void)mode;
+        return nullptr;
+    }
+
+    void RaytracingResources::resetBottomLevelAS() {
+        bottomLevelASVector.clear();
+    }
+
+    void RaytracingResources::addBottomLevelASMesh(const RenderBottomLevelASMesh &mesh) {
+        // Recorded so the frame's traced draw calls are known; the structures themselves arrive
+        // with patch 0003.
+        bottomLevelASVector.push_back(mesh);
+    }
+
+    void RaytracingResources::updateBottomLevelASResources(RenderWorker *worker) {
+        (void)worker;
+    }
+
+    void RaytracingResources::submitBottomLevelASCreation(RenderWorker *worker) {
+        (void)worker;
+    }
+
+    void RaytracingResources::updateTopLevelASResources(RenderWorker *worker, const std::vector<InstanceDrawCall> &instanceDrawCalls, const std::vector<uint32_t> &instanceIndices) {
+        (void)worker;
+        (void)instanceDrawCalls;
+        (void)instanceIndices;
+    }
+
+    void RaytracingResources::submitTopLevelASCreation(RenderWorker *worker) {
+        (void)worker;
+    }
+
+    void RaytracingResources::createShaderBindingTable(RenderWorker *worker, const RaytracingState *rtState, RenderDescriptorSet **descriptorSets, uint32_t descriptorSetCount, const std::vector<RenderPipelineProgram> &hitGroups) {
+        (void)worker;
+        (void)rtState;
+        (void)descriptorSets;
+        (void)descriptorSetCount;
+        (void)hitGroups;
+    }
+
+    void RaytracingResources::updateLightsBuffer(RenderWorker *worker, const RaytracingScene &rtScene) {
+        (void)worker;
+        (void)rtScene;
+    }
+
+    void RaytracingResources::updateShaderSets(RenderWorker *worker, const ShaderLibrary *shaderLibrary) {
+        (void)worker;
+        (void)shaderLibrary;
+    }
+
+    void RaytracingResources::updateMultisampling() {
+        // Nothing depends on the sample count yet. This is the one method the renderer calls at
+        // level Off, so it must stay a no-op until the textures it would recreate exist.
+    }
+
+    void RaytracingResources::setRaytracingConfig(const RaytracingConfiguration &rtConfig, bool resolutionChanged) {
+        // The values the renderer reads back are kept in step so the inspector's edits are
+        // visible; no texture is made or remade for them yet.
+        upscalerMode = rtConfig.upscalerMode;
+        upscalerReactiveMask = rtConfig.upscalerReactiveMask;
+        upscalerLockMask = rtConfig.upscalerLockMask;
+        denoiserEnabled = rtConfig.denoiserEnabled;
+        maxReflections = rtConfig.maxReflections;
+        rtParams.diSamples = uint32_t(rtConfig.diSamples);
+        rtParams.giSamples = uint32_t(rtConfig.giSamples);
+        rtParams.maxLights = uint32_t(rtConfig.maxLights);
+        rtParams.motionBlurStrength = rtConfig.motionBlurStrength;
+        rtParams.motionBlurSamples = uint32_t(rtConfig.motionBlurSamples);
+        rtParams.visualizationMode = rtConfig.visualizationMode;
+        (void)resolutionChanged;
+    }
+
+    void RaytracingResources::createOutputBuffers(RenderWorker *worker, uint32_t width, uint32_t height) {
+        (void)worker;
+        textureWidth = width;
+        textureHeight = height;
+    }
+
+    void RaytracingResources::updateInterleavedRenderTargets(RenderWorker *worker, uint32_t width, uint32_t height, uint32_t count, const RenderMultisampling &multisampling, bool usesHDR) {
+        (void)worker;
+        (void)width;
+        (void)height;
+        (void)count;
+        (void)multisampling;
+        (void)usesHDR;
+    }
+};
diff --git a/src/render/rt64_raytracing_resources.h b/src/render/rt64_raytracing_resources.h
new file mode 100644
index 0000000..e12310a
--- /dev/null
+++ b/src/render/rt64_raytracing_resources.h
@@ -0,0 +1,209 @@
+//
+// RT64, the renderer's patch series (OoT: Recompiled), patch 0002.
+//
+// The per frame ray tracing resources the pinned renderer names and does not ship: the
+// configuration the inspector edits, the scene a traced projection becomes, and the buffers,
+// textures, descriptor sets and acceleration structures the framebuffer renderer binds when it
+// records a traced scene.
+//
+// THIS IS THE SMALLEST THING THAT COMPILES. Every member the renderer touches is declared with
+// the type the renderer expects and left empty: no texture, buffer, view, descriptor set or
+// acceleration structure is created, and every method is a no-op. With the ray tracing level Off
+// (the only level until patch 0008) the renderer never reaches into any of it past construction
+// and updateMultisampling(), so Off stays byte identical to the baseline. The passes fill this in
+// from patch 0003 (the acceleration structures) on. Nothing here is edited then; a later patch
+// changes it.
+//
+
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+#include "common/rt64_common.h"
+#include "common/rt64_plume.h"
+#include "common/rt64_user_configuration.h"
+#include "preset/rt64_preset_scene.h"
+#include "shared/rt64_hlsl.h"
+#include "shared/rt64_interleaved_raster.h"
+#include "shared/rt64_point_light.h"
+#include "shared/rt64_raytracing_params.h"
+
+#include "rt64_buffer_uploader.h"
+#include "rt64_descriptor_sets.h"
+#include "rt64_framebuffer_renderer_call.h"
+#include "rt64_raytracing_shader_cache.h"
+#include "rt64_render_target.h"
+#include "rt64_render_target_manager.h"
+#include "rt64_render_worker.h"
+#include "rt64_shader_library.h"
+#include "rt64_upscaler.h"
+
+namespace RT64 {
+    // What the inspector's ray tracing panel edits and the shared queue resources carry to the
+    // workload queue. The defaults are the ones the passes are designed against; the settings
+    // row (patch 0008) maps its levels onto these.
+    struct RaytracingConfiguration {
+        int diSamples = 1;
+        int giSamples = 1;
+        int maxLights = 16;
+        int maxReflections = 1;
+        int motionBlurSamples = 0;
+        float motionBlurStrength = 0.0f;
+        interop::VisualizationMode visualizationMode = interop::VisualizationMode::Final;
+        UpscaleMode upscalerMode = UpscaleMode::Bilinear;
+        Upscaler::QualityMode upscalerQualityMode = Upscaler::QualityMode::Auto;
+        float upscalerSharpness = 0.5f;
+        bool upscalerResolutionOverride = false;
+        float resolutionScale = 1.0f;
+        bool upscalerReactiveMask = true;
+        bool upscalerLockMask = true;
+        bool denoiserEnabled = true;
+    };
+
+    // One traced projection of one framebuffer pair: the instances that went into it, the
+    // matrices, the viewport, the lights the game set, and the rasterized scenes interleaved
+    // with it (drawn to their own targets and composited by the traced pass).
+    struct RaytracingScene {
+        std::vector<uint32_t> instanceIndices;
+        std::vector<interop::InterleavedRaster> interleavedRasters;
+        PresetScene presetScene;
+        hlslpp::float4x4 curViewMatrix;
+        hlslpp::float4x4 curProjMatrix;
+        hlslpp::float4x4 prevViewMatrix;
+        hlslpp::float4x4 prevProjMatrix;
+        RenderViewport viewport;
+        RenderRect scissor;
+        uint32_t screenWidth = 0;
+        uint32_t screenHeight = 0;
+        const interop::PointLight *pointLights = nullptr;
+        uint32_t lightCount = 0;
+        float deltaTime = 0.0f;
+    };
+
+    struct RaytracingResources {
+        // Hit records per pixel the any hit buffers are sized for.
+        static const uint32_t MaxHitQueries = 16;
+
+        RenderWorker *worker = nullptr;
+        UserConfiguration::GraphicsAPI graphicsAPI = UserConfiguration::GraphicsAPI::OptionCount;
+
+        // The parameter block the shaders read, and its buffer. A BufferPair, because the
+        // framebuffer renderer hands it to the shader uploader beside its own frame parameters
+        // and binds it through the pair's get().
+        interop::RaytracingParams rtParams;
+        BufferPair rtParamsBuffer;
+
+        // The lights the game set for the frame.
+        std::unique_ptr<RenderBuffer> lightsBuffer;
+
+        // The shader binding table and the acceleration structures.
+        std::unique_ptr<RenderBuffer> shaderBindingTableBuffer;
+        RenderShaderBindingTableInfo shaderBindingTableInfo;
+        std::unique_ptr<RenderAccelerationStructure> topLevelAS;
+        std::vector<RenderBottomLevelASMesh> bottomLevelASVector;
+
+        // The any hit buffers, one record per pixel per query.
+        std::unique_ptr<RenderBuffer> hitVelocityDistanceBuffer;
+        std::unique_ptr<RenderBuffer> hitColorBuffer;
+        std::unique_ptr<RenderBuffer> hitNormalFogBuffer;
+        std::unique_ptr<RenderBuffer> hitInstanceIdBuffer;
+        std::unique_ptr<RenderBufferFormattedView> hitVelocityDistanceBufferView;
+        std::unique_ptr<RenderBufferFormattedView> hitColorBufferView;
+        std::unique_ptr<RenderBufferFormattedView> hitNormalFogBufferView;
+        std::unique_ptr<RenderBufferFormattedView> hitInstanceIdBufferView;
+
+        // The output and history textures. Pairs are the current and the previous frame.
+        std::unique_ptr<RenderTexture> viewDirectionTexture;
+        std::unique_ptr<RenderTexture> shadingPositionTexture;
+        std::unique_ptr<RenderTexture> shadingNormalTexture;
+        std::unique_ptr<RenderTexture> shadingSpecularTexture;
+        std::unique_ptr<RenderTexture> instanceIdTexture;
+        std::unique_ptr<RenderTexture> diffuseTexture;
+        std::unique_ptr<RenderTexture> reflectionTexture;
+        std::unique_ptr<RenderTexture> refractionTexture;
+        std::unique_ptr<RenderTexture> transparentTexture;
+        std::unique_ptr<RenderTexture> flowTexture;
+        std::unique_ptr<RenderTexture> reactiveMaskTexture;
+        std::unique_ptr<RenderTexture> lockMaskTexture;
+        std::unique_ptr<RenderTexture> downscaledOutputTexture;
+        std::unique_ptr<RenderTexture> lumaAverageTexture;
+        std::unique_ptr<RenderTexture> upscaledOutputTexture;
+        std::unique_ptr<RenderTexture> directLightTexture[2];
+        std::unique_ptr<RenderTexture> indirectLightTexture[2];
+        std::unique_ptr<RenderTexture> normalRoughnessTexture[2];
+        std::unique_ptr<RenderTexture> filteredDirectLightTexture[2];
+        std::unique_ptr<RenderTexture> filteredIndirectLightTexture[2];
+        std::unique_ptr<RenderTexture> depthTexture[2];
+        std::unique_ptr<RenderTexture> outputTexture[2];
+        std::unique_ptr<RenderFramebuffer> outputFramebuffer[2];
+
+        // The descriptor sets of the compose, filter, luminance and post process passes.
+        std::unique_ptr<RaytracingComposeDescriptorSet> composeSet;
+        std::unique_ptr<BicubicScalingDescriptorSet> downscaleSet;
+        std::unique_ptr<GaussianFilterDescriptorSet> indirectFilterSets[2];
+        std::unique_ptr<HistogramAverageDescriptorSet> lumaAvgSet;
+        std::unique_ptr<HistogramClearDescriptorSet> lumaClearSet;
+        std::unique_ptr<LuminanceHistogramDescriptorSet> lumaSet;
+        std::unique_ptr<HistogramSetDescriptorSet> lumaSetSet;
+        std::unique_ptr<PostProcessDescriptorSet> postProcessSet;
+
+        // The targets the interleaved raster scenes draw to.
+        std::vector<std::unique_ptr<RenderTarget>> interleavedColorTargetVector;
+        std::vector<std::unique_ptr<RenderTarget>> interleavedDepthTargetVector;
+        std::vector<std::unique_ptr<RenderFramebufferStorage>> interleavedFramebufferStorageVector;
+
+        // State the renderer reads and flips between frames.
+        UpscaleMode upscalerMode = UpscaleMode::Bilinear;
+        bool upscaleActive = false;
+        bool denoiserEnabled = false;
+        bool skipReprojection = true;
+        bool swapBuffers = false;
+        bool transitionOutputBuffers = false;
+        bool updateOutputBuffers = false;
+        bool upscalerReactiveMask = false;
+        bool upscalerLockMask = false;
+        uint32_t textureWidth = 0;
+        uint32_t textureHeight = 0;
+        int maxReflections = 0;
+
+        RaytracingResources(RenderWorker *worker, UserConfiguration::GraphicsAPI graphicsAPI);
+        ~RaytracingResources();
+
+        // The upscaler for a mode, or nullptr when none is built (which is every mode, for now).
+        Upscaler *getUpscaler(UpscaleMode mode);
+
+        // The bottom level structures: one per traced draw call, queued per frame (patch 0003).
+        void resetBottomLevelAS();
+        void addBottomLevelASMesh(const RenderBottomLevelASMesh &mesh);
+        void updateBottomLevelASResources(RenderWorker *worker);
+        void submitBottomLevelASCreation(RenderWorker *worker);
+
+        // The top level structure over the frame's instances (patch 0003).
+        void updateTopLevelASResources(RenderWorker *worker, const std::vector<InstanceDrawCall> &instanceDrawCalls, const std::vector<uint32_t> &instanceIndices);
+        void submitTopLevelASCreation(RenderWorker *worker);
+
+        // The shader binding table for the active state and its hit groups (patch 0004).
+        void createShaderBindingTable(RenderWorker *worker, const RaytracingState *rtState, RenderDescriptorSet **descriptorSets, uint32_t descriptorSetCount, const std::vector<RenderPipelineProgram> &hitGroups);
+
+        // The lights buffer from the scene's point lights (patch 0005).
+        void updateLightsBuffer(RenderWorker *worker, const RaytracingScene &rtScene);
+
+        // The descriptor sets of the compose and filter passes, rebound to the current textures.
+        void updateShaderSets(RenderWorker *worker, const ShaderLibrary *shaderLibrary);
+
+        // Called whenever the framebuffer renderer's multisampling changes, level Off included.
+        void updateMultisampling();
+
+        // The configuration from the inspector or the settings row; resolutionChanged when the
+        // output size moved and the textures have to be made again.
+        void setRaytracingConfig(const RaytracingConfiguration &rtConfig, bool resolutionChanged);
+
+        // The output textures at the traced scene's size (patch 0004).
+        void createOutputBuffers(RenderWorker *worker, uint32_t width, uint32_t height);
+
+        // The interleaved raster targets, one pair per interleaved scene (patch 0004).
+        void updateInterleavedRenderTargets(RenderWorker *worker, uint32_t width, uint32_t height, uint32_t count, const RenderMultisampling &multisampling, bool usesHDR);
+    };
+};
diff --git a/src/render/rt64_raytracing_shader_cache.cpp b/src/render/rt64_raytracing_shader_cache.cpp
