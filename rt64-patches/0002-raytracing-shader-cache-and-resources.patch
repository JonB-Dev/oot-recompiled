@@ -0,0 +1,39 @@
+//
+// RT64, the renderer's patch series (OoT: Recompiled), patch 0002.
+//
+
+#include "rt64_raytracing_shader_cache.h"
+
+namespace RT64 {
+    RaytracingShaderCache::RaytracingShaderCache(RenderDevice *device, RenderShaderFormat shaderFormat, const ShaderLibrary *shaderLibrary) {
+        this->device = device;
+        this->shaderFormat = shaderFormat;
+        this->shaderLibrary = shaderLibrary;
+    }
+
+    RaytracingShaderCache::~RaytracingShaderCache() { }
+
+    bool RaytracingShaderCache::isSetup() const {
+        return setupDone;
+    }
+
+    void RaytracingShaderCache::setup() {
+        // The pipeline layout, the ray generation, miss and hit shaders, and the two states'
+        // pipelines are built here from patch 0004 on. Until then setting up records only that
+        // it happened, so the queue does not ask again every frame.
+        setupDone = true;
+    }
+
+    void RaytracingShaderCache::submit(const ShaderDescription &shaderDesc) {
+        // Specialized hit groups per shader description arrive with the passes.
+        (void)shaderDesc;
+    }
+
+    int32_t RaytracingShaderCache::getActiveState() const {
+        return activeState;
+    }
+
+    void RaytracingShaderCache::setNextState() {
+        activeState = (activeState + 1) % int32_t(states.size());
+    }
+};
diff --git a/src/render/rt64_raytracing_shader_cache.h b/src/render/rt64_raytracing_shader_cache.h
new file mode 100644
index 0000000..979b8b4
--- /dev/null
+++ b/src/render/rt64_raytracing_shader_cache.h
@@ -0,0 +1,75 @@
+//
+// RT64, the renderer's patch series (OoT: Recompiled), patch 0002.
+//
+// The ray tracing shader cache the pinned renderer names and does not ship. The application
+// creates one at setup when the device reports the capability; the workload queue asks it to
+// set up on the first frame that has ray tracing on, submits every traced draw call's shader
+// description to it, and advances its state each frame; the framebuffer renderer reads the active
+// state's pipeline and hit groups when it records a traced scene.
+//
+// THIS IS THE SMALLEST THING THAT COMPILES. Every member the renderer touches is here with the
+// type the renderer expects, and nothing is created: no pipeline layout, no pipeline, no hit
+// group. With the ray tracing level Off (the only level until patch 0008) none of these methods
+// runs past construction, which is what keeps Off byte identical to the baseline. Patch 0004
+// onward fills them in as the passes arrive, and nothing here is edited then; a later patch
+// changes it.
+//
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <unordered_map>
+
+#include "common/rt64_plume.h"
+
+#include "rt64_shader_common.h"
+#include "rt64_shader_library.h"
+
+namespace RT64 {
+    // The key of the hit group the renderer uses for every draw call until specialized hit
+    // groups exist. It looks this up by name in the active state's map.
+    static const uint64_t UberShaderHash = 0;
+
+    struct RaytracingShaderPrograms {
+        RenderPipelineProgram surface;
+        RenderPipelineProgram shadow;
+    };
+
+    struct RaytracingState {
+        std::unique_ptr<RenderPipeline> pipeline;
+        std::unordered_map<uint64_t, RaytracingShaderPrograms> shaderProgramsMap;
+    };
+
+    struct RaytracingShaderCache {
+        RenderDevice *device = nullptr;
+        RenderShaderFormat shaderFormat{};
+        const ShaderLibrary *shaderLibrary = nullptr;
+        std::unique_ptr<RenderPipelineLayout> pipelineLayout;
+
+        // Two states so a frame can record against one while the next is being prepared. The
+        // renderer keeps a pointer into this array across a frame, so it is an array and never a
+        // vector that could move.
+        std::array<RaytracingState, 2> states;
+
+        RaytracingShaderCache(RenderDevice *device, RenderShaderFormat shaderFormat, const ShaderLibrary *shaderLibrary);
+        ~RaytracingShaderCache();
+
+        // True once setup() has run. The workload queue calls setup() on the first frame with ray
