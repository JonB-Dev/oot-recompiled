+    // A SEE-THROUGH DRAW THAT IS LIGHT CASTS NO SHADOW (patch 0056, the user, 2026-10-12: "beams
+    // themselves now cast shadows of their own so they cause shadows inside themselves. noticed this
+    // on the trifoce during stories, beams from windows in template of time windows as kid/young
+    // link, and other various points ... beams of "light" must never be castiing a shadow of the
+    // beams themselves").
+    //
+    // The foliage rule (patch 0017) makes every see-through draw of more than two triangles that
+    // reads depth a solid traced surface, and 0039 takes back out only a draw the shaft test passes:
+    // round, upright or leaning from above, a fading texture. A beam that fails that test (the flat
+    // ray pieces through the hall's side windows a child sees, a fan of rays round the triangles in
+    // a story, a cone drawn in layers) stayed solid. As solid geometry it is in every shadow ray's
+    // way, so it blocks the windows' light and the beam lights that fall along it, and it is shaded
+    // like a wall before the composite, so the shadows it throws land on itself.
+    //
+    // WHICH DRAWS ARE LIGHT is the open question, so each answer is its own switch on the Debugging
+    // menu (the user's standing rule, 2026-10-12: "temporary debugs with all fix possibilities as
+    // separate options so that i can enable or disable and mix and match"), one bit each in
+    // tuneLightTest.z, any one of them enough:
+    //   1  a fading texture: partial alpha nearly everywhere, the kind every beam, glow and haze
+    //      has and a cut-out never does (the 2026-10-08 inventory found the two far apart)
+    //   2  a gray texture (intensity, or intensity with alpha): its color comes from the draw's
+    //      own colors, as light does, where a leaf or a vine is painted in its texture
+    //   4  an added blend: what is behind is kept whole and the draw is added over it, which is
+    //      light by definition
+    //   8  a long shape: four times as long as it is across and at least 150 units, whatever its
+    //      roundness or its lean, so a flat strip of rays counts as a shaft does
+    // What passes is what 0039 makes a shaft: a see-through overlay no ray traces, drawn after the
+    // composite in its own brightness. The lights 0029 and 0030 make are untouched.
+    static const uint32_t LightFadingTexture = 1u;
+    static const uint32_t LightGrayTexture = 2u;
+    static const uint32_t LightAddedBlend = 4u;
+    static const uint32_t LightLongShape = 8u;
+
+    // The blender's inputs for the cycle that writes the frame (the second in two cycle mode).
+    static bool addsOverWhatIsBehind(const interop::OtherMode &otherMode) {
+        const bool twoCycle = (otherMode.cycleType() == G_CYC_2CYCLE);
+        const uint32_t shift = twoCycle ? 16u : 18u;
+        const uint32_t memoryColor = (otherMode.L >> (shift + 4u)) & 3u;   // m2a
+        const uint32_t memoryWeight = (otherMode.L >> shift) & 3u;        // m2b
+        const uint32_t clrMem = 1u;   // G_BL_CLR_MEM
+        const uint32_t one = 2u;      // G_BL_1
+        return otherMode.forceBlend() && (memoryColor == clrMem) && (memoryWeight == one);
+    }
+
+    static bool longFromDraw(const DrawData &drawData, const GameCall &call) {
+        hlslpp::float3 points[MaxBeamTriangles * 3];
+        uint32_t count = 0;
+        hlslpp::float3 mean;
+        hlslpp::float4 shade;
+        if (!drawPoints(drawData, call, points, count, mean, shade)) {
+            return false;
+        }
+
+        float values[3];
+        float vectors[3][3];
+        drawAxes(points, count, mean, values, vectors);
+        if ((values[0] <= 0.0f) || (values[0] < (BeamMinElongation * (values[1] + values[2])))) {
+            return false;
+        }
+
+        const hlslpp::float3 axis = hlslpp::normalize(hlslpp::float3(vectors[0][0], vectors[1][0], vectors[2][0]));
+        float alongMin = 1e30f;
+        float alongMax = -1e30f;
+        for (uint32_t i = 0; i < count; i++) {
+            const float along = float(hlslpp::dot(points[i] - mean, axis));
+            alongMin = std::min(alongMin, along);
+            alongMax = std::max(alongMax, along);
+        }
+
+        return (alongMax - alongMin) >= BeamMinLength;
+    }
+
+    static bool seeThroughIsLight(const DrawData &drawData, const GameCall &call, uint32_t rules) {
+        if (rules == 0u) {
+            return false;
+        }
+
+        const interop::OtherMode &otherMode = call.callDesc.otherMode;
+        if (((rules & LightAddedBlend) != 0u) && addsOverWhatIsBehind(otherMode)) {
+            return true;
+        }
+
+        if (call.callDesc.tileCount == 0) {
+            return false;
+        }
+
+        const DrawCallTile &tile = drawData.callTiles[call.callDesc.tileIndex];
+        if (!tile.valid || tile.tileCopyUsed) {
+            return false;
+        }
+
+        const TextureAlphaKind alphaKind = textureAlphaKind(tile.tmemHashOrID);
+        if (alphaKind == TextureAlphaKind::Cutout) {
+            return false;   // a leaf, a vine, a fence: whole texels or none
+        }
+
+        if (((rules & LightFadingTexture) != 0u) && (alphaKind == TextureAlphaKind::Fade)) {
+            return true;
+        }
+
+        if (((rules & LightGrayTexture) != 0u) && ((tile.loadTile.fmt == G_IM_FMT_I) || (tile.loadTile.fmt == G_IM_FMT_IA))) {
+            return true;
+        }
+
+        return ((rules & LightLongShape) != 0u) && longFromDraw(drawData, call);
+    }
+
     // A LATTICE WINDOW IS A LIGHT (patch 0030). The Temple of Time's windows are glass painted on
     // its walls, not openings, so no traced sun can come through them, and the hall below them was
     // lit as though they were stone (the user, 2026-10-08: "the windows in the Temple of Time ...
@@ -2949,6 +3077,15 @@ namespace RT64 {
