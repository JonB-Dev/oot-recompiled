     const std::vector<uint8_t> &RaytracingBlueNoise::atlasBGRA8() {
         static const std::vector<uint8_t> atlas = [] {
+            // Slice k is the mask advanced by k steps of the golden ratio and wrapped: blue in
+            // space on every slice, and for any one pixel a low discrepancy sequence over the
+            // slices, so a sample that accumulates over frames converges rather than flickers.
+            static_assert(BlueNoiseMaskSize == SliceSize, "the masks are the slice size");
+            static_assert(BlueNoiseMaskChannels == 3, "one mask per color channel");
+            const float GoldenStep = 0.61803398875f;
             std::vector<uint8_t> bytes(AtlasWidth * AtlasHeight * 4);
             for (uint32_t y = 0; y < AtlasHeight; y++) {
                 for (uint32_t x = 0; x < AtlasWidth; x++) {
