+    // EVERY WINDOW IN A DRAW, NOT ONE WINDOW PER DRAW (patch 0032). The hall's side windows are
+    // drawn by one actor (Bg_Toki_Hikari) in ONE draw: four windows on the two side walls and one
+    // at the front, five separate pieces facing three ways, which is not one flat plane, so the
+    // draw was never taken as a window and its glass, hung a little in front of the wall, only
+    // shadowed the wall under it (the user, 2026-10-08: "as if they're an object hanging in front
+    // of the wall"). So a draw is split into its pieces, the triangles joined by a shared corner,
+    // and each piece is measured as a window of its own.
+    static const uint32_t MaxWindowTriangles = 64;
+
+    static void windowsFromDraw(const DrawData &drawData, const GameCall &call, const hlslpp::float3 &eye, std::vector<interop::PointLight> &windows) {
+        const uint32_t triangleCount = call.callDesc.triangleCount;
+        const uint32_t start = call.meshDesc.faceIndicesStart;
+        if ((triangleCount < 1) || (triangleCount > MaxWindowTriangles) || ((start + triangleCount * 3) > drawData.faceIndices.size())) {
+            return;
+        }
+
+        // Union the triangles that share a corner.
+        uint32_t parent[MaxWindowTriangles];
+        for (uint32_t t = 0; t < triangleCount; t++) {
+            parent[t] = t;
+        }
+
+        auto root = [&](uint32_t t) {
+            while (parent[t] != t) {
+                parent[t] = parent[parent[t]];
+                t = parent[t];
+            }
+            return t;
+        };
+
+        for (uint32_t a = 0; a < triangleCount; a++) {
+            for (uint32_t b = a + 1; b < triangleCount; b++) {
+                bool shared = false;
+                for (uint32_t i = 0; (i < 3) && !shared; i++) {
+                    for (uint32_t j = 0; (j < 3) && !shared; j++) {
+                        shared = (drawData.faceIndices[start + a * 3 + i] == drawData.faceIndices[start + b * 3 + j]);
+                    }
+                }
+
+                if (shared) {
+                    parent[root(a)] = root(b);
+                }
+            }
+        }
+
+        bool done[MaxWindowTriangles] = {};
+        for (uint32_t first = 0; first < triangleCount; first++) {
+            const uint32_t piece = root(first);
+            if (done[piece]) {
+                continue;
+            }
+
+            done[piece] = true;
+            hlslpp::float3 points[MaxWindowTriangles * 3];
+            uint32_t vertices[MaxWindowTriangles * 3];
+            uint32_t count = 0;
+            bool readable = true;
+            for (uint32_t t = 0; (t < triangleCount) && readable; t++) {
+                if (root(t) != piece) {
+                    continue;
+                }
+
+                for (uint32_t i = 0; i < 3; i++) {
+                    const uint32_t v = drawData.faceIndices[start + t * 3 + i];
+                    if (std::find(vertices, vertices + count, v) != (vertices + count)) {
+                        continue;
+                    }
+
+                    if ((v >= drawData.worldIndices.size()) || (((v + 1) * 3) > drawData.posFloats.size()) ||
+                        (drawData.worldIndices[v] >= drawData.worldTransforms.size())) {
+                        readable = false;
+                        break;
+                    }
+
+                    const hlslpp::float4 local(drawData.posFloats[v * 3 + 0], drawData.posFloats[v * 3 + 1], drawData.posFloats[v * 3 + 2], 1.0f);
+                    const hlslpp::float4x4 worldMatrix = drawData.worldTransforms[drawData.worldIndices[v]];
+                    const hlslpp::float4 world = hlslpp::mul(local, worldMatrix);
+                    vertices[count] = v;
+                    points[count] = world.xyz;
+                    count++;
+                }
+            }
+
+            interop::PointLight window;
+            if (readable && windowFromPoints(points, count, eye, window)) {
+                windows.push_back(window);
+            }
+        }
+    }
