diff --git a/src/shaders/RtDepthResolveCS.hlsl b/src/shaders/RtDepthResolveCS.hlsl
new file mode 100644
index 0000000..90c8903
--- /dev/null
+++ b/src/shaders/RtDepthResolveCS.hlsl
@@ -0,0 +1,49 @@
+//
+// RT64, the renderer's patch series (OoT: Recompiled), patch 0008.
+//
+// The game's own rasterized depth, one sample per pixel, for the traced passes. The primary ray
+// compares each hit against it: a hit the raster does not show at that pixel is the cut-out part
+// of an alpha-tested quad (a tree line, a cliff's ragged top), which the rays treat as solid until
+// the material work arrives, and lighting it painted a band on the sky behind. The depth target
+// is multisampled when antialiasing is on, so this is built twice, and either way the passes read
+// one plain texture.
+//
+
+#if defined(MULTISAMPLING)
+Texture2DMS<float> gDepth : register(t1);
+#else
+Texture2D<float> gDepth : register(t1);
+#endif
+
+RWTexture2D<float> gOutput : register(u2);
+
+[numthreads(8, 8, 1)]
+void CSMain(uint2 pixel : SV_DispatchThreadID) {
+    uint width;
+    uint height;
+    gOutput.GetDimensions(width, height);
+    if ((pixel.x >= width) || (pixel.y >= height)) {
+        return;
+    }
+
+#if defined(MULTISAMPLING)
+    // The NEAREST sample: a pixel on a figure's edge holds the figure in some samples and the
+    // ground behind in the rest, and the first sample alone was the ground often enough that
+    // the rays' hit on the figure was dropped along a one pixel rim, which kept the game's own
+    // color beside the shaded figure: a white line following Link's contour as he walked (the
+    // user, 2026-09-24). A cut-out quad's transparent part holds the background in every
+    // sample, so the nearest is still behind the hit and the compare still drops it.
+    uint width2;
+    uint height2;
+    uint samples;
+    gDepth.GetDimensions(width2, height2, samples);
+    float depth = gDepth.Load(int2(pixel), 0);
+    for (uint s = 1; s < samples; s++) {
+        depth = min(depth, gDepth.Load(int2(pixel), int(s)));
+    }
+
+    gOutput[pixel] = depth;
+#else
+    gOutput[pixel] = gDepth.Load(int3(pixel, 0));
+#endif
+}
diff --git a/src/shaders/RtFilterCS.hlsl b/src/shaders/RtFilterCS.hlsl
new file mode 100644
index 0000000..909b89f
--- /dev/null
+++ b/src/shaders/RtFilterCS.hlsl
@@ -0,0 +1,82 @@
+//
+// RT64, the renderer's patch series (OoT: Recompiled), patch 0008.
+//
+// The spatial filter over the direct light factor (phase 57): what the history cannot cover,
+// since every pass is one noisy sample per pixel per frame and the history reaches only where
+// the previous frame saw the same point. One step of an a trous filter: a 5 by 5 kernel whose
+// taps sit STEP pixels apart, weighted by how alike the tap's surface is to the pixel's (its
+// normal, whether it lies on the pixel's tangent plane) and by how alike the two factors are, so
+// a shadow's edge and a wall's edge both stay where they are while the grain between them
+// averages out. Built twice, STEP 1 then STEP 2, run in that order; the user asked for the
+// grain to go ("ray reconstruction", 2026-09-24), and this is the part of it every GPU has.
+//
+
+#ifndef STEP
+#define STEP 1
+#endif
+
+RWTexture2D<float4> gInput : register(u1);
+RWTexture2D<float4> gPosition : register(u2);
+RWTexture2D<float4> gNormal : register(u3);
+RWTexture2D<int> gInstance : register(u4);
+RWTexture2D<float4> gOutput : register(u5);
+
+static const float Kernel[5] = { 1.0f / 16.0f, 1.0f / 4.0f, 3.0f / 8.0f, 1.0f / 4.0f, 1.0f / 16.0f };
+static const float NormalPower = 64.0f;   // how sharply the weight falls as the normals part
+static const float PlaneSlope = 4.0f;     // a tap off the tangent plane by a quarter of its distance weighs nothing
+static const float FactorSigma = 0.25f;   // the factor difference that halves a tap's weight, about
+
+float luminance(float3 c) {
+    return dot(c, float3(0.299f, 0.587f, 0.114f));
+}
+
+[numthreads(8, 8, 1)]
+void CSMain(uint2 pixel : SV_DispatchThreadID) {
+    uint width;
+    uint height;
+    gOutput.GetDimensions(width, height);
+    if ((pixel.x >= width) || (pixel.y >= height)) {
+        return;
+    }
+
+    const float4 center = gInput[pixel];
+    if (gInstance[pixel] < 0) {
+        gOutput[pixel] = center;
+        return;
+    }
+
+    const float3 normal = gNormal[pixel].xyz;
+    const float3 position = gPosition[pixel].xyz;
+    const float centerLuma = luminance(center.rgb);
+    float3 sum = 0.0f;
+    float weightSum = 0.0f;
+    for (int j = -2; j <= 2; j++) {
+        for (int i = -2; i <= 2; i++) {
+            const int2 tap = int2(pixel) + int2(i, j) * STEP;
+            if ((tap.x < 0) || (tap.y < 0) || (tap.x >= int(width)) || (tap.y >= int(height))) {
+                continue;
+            }
+
+            if (gInstance[tap] < 0) {
+                continue;
+            }
+
+            float weight = Kernel[i + 2] * Kernel[j + 2];
+            const float3 tapNormal = gNormal[tap].xyz;
+            weight *= pow(saturate(dot(normal, tapNormal)), NormalPower);
+
+            const float3 offset = gPosition[tap].xyz - position;
+            const float distance = length(offset);
+            if (distance > 0.0f) {
+                weight *= saturate(1.0f - PlaneSlope * abs(dot(normal, offset)) / distance);
+            }
+
+            const float4 value = gInput[tap];
+            weight *= exp(-abs(luminance(value.rgb) - centerLuma) / FactorSigma);
+            sum += value.rgb * weight;
+            weightSum += weight;
+        }
+    }
+
+    gOutput[pixel] = (weightSum > 0.0f) ? float4(sum / weightSum, center.a) : center;
+}
