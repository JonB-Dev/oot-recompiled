+    void RaytracingResources::filterDirectLight(RenderWorker *worker, const ShaderLibrary *shaderLibrary) {
+        if ((filterSets[0] == nullptr) || (filteredDirectLightTexture[0] == nullptr) || (shadingPositionTexture == nullptr)) {
+            return;
+        }
+        RtFilterDescriptorSet *const sets[2] = { filterSets[0].get(), filterSets[1].get() };
+        RenderTexture *const ping[2] = { filteredDirectLightTexture[0].get(), filteredDirectLightTexture[1].get() };
+        filterLight(worker, shaderLibrary, sets, ping);
+        worker->commandList->barriers(RenderBarrierStage::COMPUTE, RenderTextureBarrier(filteredDirectLightTexture[1].get(), RenderTextureLayout::SHADER_READ));
+    }
+
+    void RaytracingResources::filterLight(RenderWorker *worker, const ShaderLibrary *shaderLibrary, RtFilterDescriptorSet *const sets[2], RenderTexture *const ping[2]) {
+        if (filterSteps <= 0) {
+            return;
+        }
+
+        // The input sits in the second slot; the first step reads it into the first slot, the
+        // second step back into the second, which is where the result is read. With one step
+        // asked for, the one step runs twice over (the second at the wider spacing is what is
+        // left out), so the result is still in the second slot.
+        const ShaderRecord *steps[2] = { &shaderLibrary->rtFilter1, (filterSteps >= 2) ? &shaderLibrary->rtFilter2 : &shaderLibrary->rtFilter1 };
+        for (uint32_t step = 0; step < 2; step++) {
+            RenderTexture *input = ping[(step == 0) ? 1 : 0];
+            RenderTexture *output = ping[(step == 0) ? 0 : 1];
+            RtFilterDescriptorSet *set = sets[step];
+            set->setTexture(set->gInput, input, RenderTextureLayout::GENERAL);
+            set->setTexture(set->gPosition, shadingPositionTexture.get(), RenderTextureLayout::GENERAL);
+            set->setTexture(set->gNormal, shadingNormalTexture.get(), RenderTextureLayout::GENERAL);
+            set->setTexture(set->gInstance, instanceIdTexture.get(), RenderTextureLayout::GENERAL);
+            set->setTexture(set->gOutput, output, RenderTextureLayout::GENERAL);
+
+            RenderTextureBarrier stepBarriers[] = {
+                RenderTextureBarrier(input, RenderTextureLayout::GENERAL),
+                RenderTextureBarrier(output, RenderTextureLayout::GENERAL)
+            };
+
+            worker->commandList->barriers(RenderBarrierStage::COMPUTE, stepBarriers, uint32_t(std::size(stepBarriers)));
+            worker->commandList->setPipeline(steps[step]->pipeline.get());
+            worker->commandList->setComputePipelineLayout(steps[step]->pipelineLayout.get());
+            worker->commandList->setComputeDescriptorSet(set->get(), 0);
+            worker->commandList->dispatch((textureWidth + 7) / 8, (textureHeight + 7) / 8, 1);
+        }
+    }
+
+    void RaytracingResources::temporalAndFilterBounce(RenderWorker *worker, const ShaderLibrary *shaderLibrary) {
+        if ((bounceTemporalSet == nullptr) || (filteredIndirectLightTexture[0] == nullptr) || (indirectLightTexture[0] == nullptr)) {
+            return;
+        }
+        RenderTexture *raw = indirectLightTexture[swapBuffers ? 1 : 0].get();
+        RenderTexture *previous = indirectLightTexture[swapBuffers ? 0 : 1].get();
+        // The history into raw, then the filter over a copy of it and the result back into raw,
+        // which the direct pass reads and the next frame takes as its previous.
+        temporalLight(worker, shaderLibrary, bounceTemporalSet.get(), raw, previous, filteredIndirectLightTexture[0].get(), false);
+        if (filterSteps <= 0) {
+            return;
+        }
+        RenderTextureBarrier toCopy[] = {
+            RenderTextureBarrier(raw, RenderTextureLayout::COPY_SOURCE),
+            RenderTextureBarrier(filteredIndirectLightTexture[1].get(), RenderTextureLayout::COPY_DEST)
+        };
+        worker->commandList->barriers(RenderBarrierStage::COPY, toCopy, uint32_t(std::size(toCopy)));
+        worker->commandList->copyTexture(filteredIndirectLightTexture[1].get(), raw);
+        RenderTextureBarrier afterCopy[] = {
+            RenderTextureBarrier(raw, RenderTextureLayout::GENERAL),
+            RenderTextureBarrier(filteredIndirectLightTexture[1].get(), RenderTextureLayout::GENERAL)
+        };
+        worker->commandList->barriers(RenderBarrierStage::COMPUTE, afterCopy, uint32_t(std::size(afterCopy)));
+        RtFilterDescriptorSet *const sets[2] = { bounceFilterSets[0].get(), bounceFilterSets[1].get() };
+        RenderTexture *const ping[2] = { filteredIndirectLightTexture[0].get(), filteredIndirectLightTexture[1].get() };
+        filterLight(worker, shaderLibrary, sets, ping);
+        RenderTextureBarrier back[] = {
+            RenderTextureBarrier(filteredIndirectLightTexture[1].get(), RenderTextureLayout::COPY_SOURCE),
+            RenderTextureBarrier(raw, RenderTextureLayout::COPY_DEST)
+        };
+        worker->commandList->barriers(RenderBarrierStage::COPY, back, uint32_t(std::size(back)));
+        worker->commandList->copyTexture(raw, filteredIndirectLightTexture[1].get());
+        RenderTextureBarrier done[] = {
+            RenderTextureBarrier(filteredIndirectLightTexture[1].get(), RenderTextureLayout::GENERAL),
+            RenderTextureBarrier(raw, RenderTextureLayout::GENERAL)
+        };
+        worker->commandList->barriers(RenderBarrierStage::COMPUTE, done, uint32_t(std::size(done)));
+    }
+
+    void RaytracingResources::temporalDirectLight(RenderWorker *worker, const ShaderLibrary *shaderLibrary) {
+        if ((temporalSet == nullptr) || (filteredDirectLightTexture[0] == nullptr) || (statsBuffer == nullptr)) {
+            return;
+        }
+        temporalLight(worker, shaderLibrary, temporalSet.get(), directLightTexture[swapBuffers ? 1 : 0].get(), directLightTexture[swapBuffers ? 0 : 1].get(), filteredDirectLightTexture[0].get(), true);
+    }
+
+    void RaytracingResources::temporalLight(RenderWorker *worker, const ShaderLibrary *shaderLibrary, RtTemporalDescriptorSet *set, RenderTexture *raw, RenderTexture *previous, RenderTexture *scratch, bool countStats) {
+        set->setBuffer(set->RtParams, rtParamsBuffer.get(), sizeof(interop::RaytracingParams));
+        set->setTexture(set->gRaw, raw, RenderTextureLayout::GENERAL);
+        set->setTexture(set->gPrev, previous, RenderTextureLayout::GENERAL);
+        set->setTexture(set->gPosition, shadingPositionTexture.get(), RenderTextureLayout::GENERAL);
+        set->setTexture(set->gNormal, shadingNormalTexture.get(), RenderTextureLayout::GENERAL);
+        set->setTexture(set->gInstance, instanceIdTexture.get(), RenderTextureLayout::GENERAL);
+        set->setTexture(set->gPrevDepth, depthTexture[swapBuffers ? 0 : 1].get(), RenderTextureLayout::GENERAL);
+        set->setTexture(set->gPrevNormal, normalRoughnessTexture[swapBuffers ? 0 : 1].get(), RenderTextureLayout::GENERAL);
+        set->setTexture(set->gOutput, scratch, RenderTextureLayout::GENERAL);
+        // The count is one buffer and the shader always adds to it, so the bounce's run adds as
+        // well as the direct light's; the readback halves each frame's words (statsResolve).
+        set->setBuffer(set->gStats, statsBuffer.get(), 16, statsBufferView.get());
+        set->setTexture(set->gVelocity, shadingSpecularTexture.get(), RenderTextureLayout::GENERAL);   // the hit's motion, or water
+
+        RenderTextureBarrier before[] = {
+            RenderTextureBarrier(raw, RenderTextureLayout::GENERAL),
+            RenderTextureBarrier(previous, RenderTextureLayout::GENERAL),
+            RenderTextureBarrier(scratch, RenderTextureLayout::GENERAL)
+        };
+        worker->commandList->barriers(RenderBarrierStage::COMPUTE, before, uint32_t(std::size(before)));
+        worker->commandList->setPipeline(shaderLibrary->rtTemporal.pipeline.get());
+        worker->commandList->setComputePipelineLayout(shaderLibrary->rtTemporal.pipelineLayout.get());
+        worker->commandList->setComputeDescriptorSet(set->get(), 0);
+        worker->commandList->dispatch((textureWidth + 7) / 8, (textureHeight + 7) / 8, 1);
+
+        if (countStats) {
+            // The reprojection count is made here now, so the readback takes it from here (the
+            // copy after the direct pass ran before anything was counted).
+            statsCopy(worker);
+        }
+
+        // The accumulation goes back into the raw slot: what reads the pass reads it from there,
+        // and the next frame reads it as its previous.
+        RenderTextureBarrier toCopy[] = {
+            RenderTextureBarrier(scratch, RenderTextureLayout::COPY_SOURCE),
+            RenderTextureBarrier(raw, RenderTextureLayout::COPY_DEST)
+        };
+        worker->commandList->barriers(RenderBarrierStage::COPY, toCopy, uint32_t(std::size(toCopy)));
+        worker->commandList->copyTexture(raw, scratch);
+        RenderTextureBarrier back[] = {
+            RenderTextureBarrier(scratch, RenderTextureLayout::GENERAL),
+            RenderTextureBarrier(raw, RenderTextureLayout::GENERAL)
+        };
+        worker->commandList->barriers(RenderBarrierStage::COMPUTE, back, uint32_t(std::size(back)));
+    }
+
+    void RaytracingResources::statsResolve() {
+        // Like timerResolve: this slot's frame is RingDepth frames old and finished.
+        const uint32_t slot = ringIndex % RingDepth;
+        if (statsWritten[slot] && (statsReadback[slot] != nullptr)) {
+            const uint32_t *words = static_cast<const uint32_t *>(statsReadback[slot]->map());
+            // Two runs a frame add to the count since 14:50 (the direct light's and the bounce's),
+            // so each frame's words are halved to keep the trace's meaning.
+            reprojectedAccepted += words[0] / 2;
+            reprojectedTraced += words[1] / 2;
+            statsReadback[slot]->unmap();
+        }
+
+        statsWritten[slot] = false;
