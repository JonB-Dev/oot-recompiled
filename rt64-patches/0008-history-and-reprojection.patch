+    void RaytracingResources::statsClear(RenderWorker *worker) {
+        if (statsBuffer == nullptr) {
+            return;
+        }
+
+        worker->commandList->barriers(RenderBarrierStage::COPY, RenderBufferBarrier(statsBuffer.get(), RenderBufferAccess::WRITE));
+        worker->commandList->copyBufferRegion(statsBuffer->at(0), statsZeroBuffer->at(0), 16);
+        worker->commandList->barriers(RenderBarrierStage::COMPUTE, RenderBufferBarrier(statsBuffer.get(), RenderBufferAccess::WRITE));
+    }
+
+    void RaytracingResources::statsCopy(RenderWorker *worker) {
+        if (statsBuffer == nullptr) {
+            return;
+        }
+
+        const uint32_t slot = ringIndex % RingDepth;
+        worker->commandList->barriers(RenderBarrierStage::COPY, RenderBufferBarrier(statsBuffer.get(), RenderBufferAccess::READ));
+        worker->commandList->copyBufferRegion(statsReadback[slot]->at(0), statsBuffer->at(0), 16);
+        worker->commandList->barriers(RenderBarrierStage::COMPUTE, RenderBufferBarrier(statsBuffer.get(), RenderBufferAccess::WRITE));
+        statsWritten[slot] = true;
+    }
