+    void RaytracingResources::resolveRasterDepth(RenderWorker *worker, RenderTarget *depthTarget, const ShaderLibrary *shaderLibrary) {
+        if ((depthTarget == nullptr) || (depthTarget->texture == nullptr) || (rasterDepthTexture == nullptr) || (depthResolveSet == nullptr)) {
+            rasterDepthValid = false;
+            return;
+        }
+
+        // The depth target is read as a texture while it is resolved, and the renderer puts it
+        // back to depth writing with the color target after the traced pass.
+        depthResolveSet->setTexture(depthResolveSet->gDepth, depthTarget->texture.get(), RenderTextureLayout::DEPTH_READ, depthTarget->textureView.get());
+        depthResolveSet->setTexture(depthResolveSet->gOutput, rasterDepthTexture.get(), RenderTextureLayout::GENERAL);
+
+        RenderTextureBarrier beforeBarriers[] = {
+            RenderTextureBarrier(depthTarget->texture.get(), RenderTextureLayout::DEPTH_READ),
+            RenderTextureBarrier(rasterDepthTexture.get(), RenderTextureLayout::GENERAL)
+        };
+
+        worker->commandList->barriers(RenderBarrierStage::COMPUTE, beforeBarriers, uint32_t(std::size(beforeBarriers)));
+
+        const bool multisampled = depthTarget->multisampling.sampleCount > 1;
+        const ShaderRecord &resolve = multisampled ? shaderLibrary->rtDepthResolveMS : shaderLibrary->rtDepthResolve;
+        worker->commandList->setPipeline(resolve.pipeline.get());
+        worker->commandList->setComputePipelineLayout(resolve.pipelineLayout.get());
+        worker->commandList->setComputeDescriptorSet(depthResolveSet->get(), 0);
+        worker->commandList->dispatch((textureWidth + 7) / 8, (textureHeight + 7) / 8, 1);
+        worker->commandList->barriers(RenderBarrierStage::COMPUTE, RenderTextureBarrier(rasterDepthTexture.get(), RenderTextureLayout::GENERAL));
+        rasterDepthValid = true;
+    }
