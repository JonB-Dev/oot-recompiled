+//
+// RT64, the renderer's patch series (OoT: Recompiled), patch 0008.
+//
+// The history of the direct light factor, with TEMPORAL CLAMPING. The direct pass writes one raw
+// sample per pixel per frame; this step reprojects the pixel's surface point into the previous
+// frame, takes the factor accumulated there when the previous frame saw the same surface (its
+// normal and its depth agree), CLAMPS that history to the range of raw factors in the pixel's 3
+// by 3 neighborhood this frame, and blends the new sample in at the smoothing control's share.
+//
+// The clamp is the whole point. A shadow or a bounced color cast BY something that moves onto a
+// surface that did not reprojects as valid (the surface is still there), so the old value stayed
+// and faded at the blend rate: "trailing shadows and colors that seem to paint behind movement
+// and fade over time" (the user, 2026-09-24, two recordings). A history the present frame's
+// neighborhood cannot support is a stale one and is pulled into range in a single frame, while
+// a noisy penumbra, whose neighborhood spans lit and shadowed, still accumulates.
+//
+
+#include "shared/rt64_raytracing_params.h"
+
+ConstantBuffer<RaytracingParams> RtParams : register(b0);
+RWTexture2D<float4> gRaw : register(u1);         // this frame's raw factor
+RWTexture2D<float4> gPrev : register(u2);        // the previous frame's accumulated factor
+RWTexture2D<float4> gPosition : register(u3);
+RWTexture2D<float4> gNormal : register(u4);
+RWTexture2D<int> gInstance : register(u5);
+RWTexture2D<float> gPrevDepth : register(u6);
+RWTexture2D<float4> gPrevNormal : register(u7);
+RWTexture2D<float4> gOutput : register(u8);      // the accumulated factor for this frame
+RWBuffer<uint> gStats : register(u9);            // [0] accepted, [1] traced, on one pixel in 64
+RWTexture2D<float4> gVelocity : register(u10);   // the hit's motion since the previous presented frame (xyz) where w is 0; water otherwise
+
+static const float ClampMargin = 0.02f;
+// World units per game frame. The still world's velocity is exactly zero (the same matrix both
+// frames), so the bar sits just above rounding: half a unit let Link's idle animation through,
+// and the shadows of his own hat and arms painted over his face as they crept (the user,
+// 2026-09-24, "the painting on links shadows ... now on his model").
+static const float MovingThreshold = 0.01f;
+// How far the clamp may move a history before the pixel is taken as crossed by a shadow that
+// moves over ground that does not (above the neighborhood's own spread), and over how much
+// more of a move the history is given up entirely. In the factor's own units, where 1 is the
+// surface at its full light.
+static const float RejectMargin = 0.05f;
+static const float RejectRange = 0.25f;
+
+// The same test the passes used to make themselves (Raytracing.hlsl, reprojectHistory).
+bool reprojectHistory(float3 position, float3 normal, out int2 previousPixel) {
+    previousPixel = int2(0, 0);
+    if (RtParams.reprojectValid == 0) {
+        return false;
+    }
+
+    const float4 clip = mul(RtParams.prevViewProj, float4(position, 1.0f));
+    if (clip.w <= 0.0f) {
+        return false;
+    }
+
+    const float2 ndc = clip.xy / clip.w;
+    const float2 viewportOrigin = RtParams.viewport.xy;
+    const float2 viewportSize = RtParams.viewport.zw;
+    const float2 inViewport = float2(ndc.x * 0.5f + 0.5f, 0.5f - ndc.y * 0.5f) * viewportSize;
+    if (any(inViewport < 0.0f) || any(inViewport >= viewportSize)) {
+        return false;
+    }
+
+    previousPixel = int2(viewportOrigin + inViewport);
+    const float3 previousNormal = gPrevNormal[previousPixel].xyz;
+    if (dot(previousNormal, normal) < 0.8f) {
+        return false;
+    }
+
+    const float expectedDepth = sqrt(saturate(length(position - RtParams.prevEye.xyz) / RtParams.farDist));
+    const float previousDepth = gPrevDepth[previousPixel];
+    return abs(previousDepth - expectedDepth) < (0.01f + 0.03f * expectedDepth);
+}
+
+[numthreads(8, 8, 1)]
+void CSMain(uint2 pixel : SV_DispatchThreadID) {
+    uint width;
+    uint height;
+    gOutput.GetDimensions(width, height);
+    if ((pixel.x >= width) || (pixel.y >= height)) {
+        return;
+    }
+
+    const float4 raw = gRaw[pixel];
+    if (gInstance[pixel] < 0) {
+        gOutput[pixel] = raw;
+        return;
+    }
+
+    const float blend = RtParams.tuneFade.w;   // the smoothing control: 1 is no history
+    // A SURFACE THAT MOVED IS REPROJECTED BY ITS MOTION. The hit's position less how far it moved
+    // since the previous presented frame is where the same point of the surface was, and that
+    // is what goes through the previous camera; the still world's motion is zero and nothing
+    // changes for it. Before this (2026-09-24) a moving surface kept no history at all, first
+    // because the current position reprojected onto another part of Link and his self shadow
+    // smeared over his face, then because the cure left him one sample a frame and grainy. The
+    // normal and depth tests still refuse a limb that turned; the clamp still pulls a stale
+    // shadow into this frame's range. The motion rides in the specular slot where the surface
+    // is not water (w is zero); water's slot holds its normal and does not move.
+    const float4 motion = gVelocity[pixel];
+    const float3 velocity = (motion.w > 0.0f) ? float3(0.0f, 0.0f, 0.0f) : motion.xyz;
+    float3 result = raw.rgb;
+    bool accepted = false;
+    // The factor's spare channel carries how many presented frames of history the pixel holds
+    // (1 when it took this frame's sample alone), for the History view of the Inspect row; the
+    // filter passes it through and the compose never reads it.
+    float age = 1.0f;
+    if (blend < 1.0f) {
+        int2 previousPixel;
+        accepted = reprojectHistory(gPosition[pixel].xyz - velocity, gNormal[pixel].xyz, previousPixel);
+        if (accepted) {
+            // The range this frame can support: the mean of the 3 by 3 neighborhood's raw factors
+            // plus or minus one deviation (surfaces only). The min and max of the nine were the
+            // first range, and with a soft sun disc the nine span lit to shadowed almost anywhere
+            // near an edge, which let a stale shadow ride along behind a moving one (the user,
+            // 14:28: "paint trail on movement is still a huge issue"); the deviation is tighter.
+            float3 mean = 0.0f;
+            float3 square = 0.0f;
+            float taps = 0.0f;
+            for (int j = -1; j <= 1; j++) {
+                for (int i = -1; i <= 1; i++) {
+                    const int2 tap = int2(pixel) + int2(i, j);
+                    if ((tap.x < 0) || (tap.y < 0) || (tap.x >= int(width)) || (tap.y >= int(height))) {
+                        continue;
+                    }
+                    if (gInstance[tap] < 0) {
+                        continue;
+                    }
+                    const float3 v = gRaw[tap].rgb;
+                    mean += v;
+                    square += v * v;
+                    taps += 1.0f;
+                }
+            }
+            mean /= max(taps, 1.0f);
+            const float3 deviation = sqrt(max(square / max(taps, 1.0f) - mean * mean, 0.0f));
+            const float3 low = mean - deviation;
+            const float3 high = mean + deviation;
+
+            const float4 previous = gPrev[previousPixel];
+            const float3 history = clamp(previous.rgb, low - ClampMargin, high + ClampMargin);
+
+            // A SHADOW THAT MOVES OVER GROUND THAT DOES NOT (2026-09-24, the user on the
+            // windmill: "a painting issue with the windmill shadow edge fade and animation as it
+            // is rotating"). The sails turn, so their shadow sweeps a floor whose own pixels
+            // never move: the history is accepted, the clamp drags the old value most of the way
+            // to the new one, and what is left behind the edge is the painting. How far the
+            // clamp had to move the history says it happened, and a pixel the edge has crossed
+            // starts again instead, taking this frame's sample whole; the spatial filter after
+            // this pass is what then smooths it. A still pixel is untouched, since its history
+            // sits inside the band and nothing is moved.
+            const float3 moved3 = abs(previous.rgb - history);
+            const float moved = max(max(moved3.r, moved3.g), moved3.b);
+            const float spread = max(max(deviation.r, deviation.g), deviation.b);
+            const float reject = saturate((moved - (spread + RejectMargin)) / RejectRange);
+            const float weight = lerp(blend, 1.0f, reject);
+
+            result = lerp(history, raw.rgb, weight);
+            age = lerp(min(previous.a + 1.0f, 64.0f), 1.0f, reject);
+        }
+    }
+
+    if (((pixel.x & 7) == 0) && ((pixel.y & 7) == 0)) {
+        uint previous;
+        if (accepted) {
+            InterlockedAdd(gStats[0], 1u, previous);
+        }
+        InterlockedAdd(gStats[1], 1u, previous);
+    }
+
+    gOutput[pixel] = float4(result, age);
+}
