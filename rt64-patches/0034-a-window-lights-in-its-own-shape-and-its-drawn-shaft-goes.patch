diff --git a/src/shaders/Raytracing.hlsl b/src/shaders/Raytracing.hlsl
--- a/src/shaders/Raytracing.hlsl
+++ b/src/shaders/Raytracing.hlsl
@@ -632,6 +632,19 @@ static const float WindowSpread = 0.015f;     // how far its shadow rays lean, s
 static const float WindowShadeShare = 0.8f;   // the share of a window's light that every surface of the place would have without its walls
 static const float WindowGlassDepth = 4.0f;   // world units either side of the glass's plane that still count as the glass
 
+// THE WINDOW'S OWN OUTLINE (patch 0034): the half width open at a height above the window's
+// middle. Straight sides up to the shoulder (the shadow offset, set on the CPU), then narrowing to
+// the point at the top, so the light leaving a pointed window is pointed too.
+float windowOpenWidth(PointLight light, float up) {
+    const float shoulder = light.shadowOffset;
+    const float top = light.spotMaxCosine;
+    if ((up <= shoulder) || ((top - shoulder) < 1.0f)) {
+        return light.pointRadius;
+    }
+
+    return light.pointRadius * saturate((top - up) / (top - shoulder));
+}
