         const hlslpp::float3 center = mean + across * (0.5f * (acrossMin + acrossMax)) + up * (0.5f * (upMin + upMax));
+
+        // THE WINDOW'S OWN OUTLINE (patch 0034, the user, 2026-10-08: the light "don't include
+        // their top points at the very top of the window ... They're just a flat rectangular object
+        // that hits the floor"). This temple's windows are pointed: straight sides up to a shoulder,
+        // then two edges meeting at a point in the middle of the top. The shoulder is the highest
+        // corner at the full width; above it the window narrows to nothing at the top. A window
+        // whose corners all reach the top is a rectangle and keeps its shoulder at the top.
+        const float acrossMid = 0.5f * (acrossMin + acrossMax);
+        const float halfWidth = 0.5f * (acrossMax - acrossMin);
+        float shoulder = upMin;
+        for (uint32_t i = 0; i < count; i++) {
+            const hlslpp::float3 d = points[i] - mean;
+            if (std::abs(float(hlslpp::dot(d, across)) - acrossMid) >= (0.9f * halfWidth)) {
+                shoulder = std::max(shoulder, float(d.y));
+            }
+        }
+
         const float level = std::sqrt(1.0f - WindowLightDrop * WindowLightDrop);
         const hlslpp::float3 falls = hlslpp::normalize(normal * level - up * WindowLightDrop);
 
