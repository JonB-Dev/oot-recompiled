+        // under a dispatch, that is a removed device. The old ones wait here for RingDepth
+        // frames, which is how long the queue can still be executing the frame that used them.
+        std::vector<std::unique_ptr<RenderBuffer>> retiredRing[RingDepth];
+
+        // The same for everything else that is remade while the GPU may still use it, or while
+        // the renderer still holds a pointer to it: the output textures and their framebuffers
+        // when the traced scene changes size (the pause menu is a different size), the
+        // interleaved targets and their storage when the size or the multisampling moves. The
+        // renderer keeps the interleaved targets in a framebuffer's transition set that it never
+        // clears (patch 0003 clears it when the slot is reused), so an interleaved target freed
+        // at once was a barrier on freed memory two frames later (the pause race, 2026-09-24).
+        std::vector<std::shared_ptr<void>> graveyardRing[RingDepth];
+
+        template <typename T>
+        void retire(std::unique_ptr<T> &object) {
+            if (object != nullptr) {
+                graveyardRing[ringIndex % RingDepth].emplace_back(std::shared_ptr<void>(std::move(object)));
+            }
+        }
+
+        std::unique_ptr<RenderBuffer> instancesRing[RingDepth];
+        uint64_t instancesRingSize[RingDepth] = {};
+        std::unique_ptr<RenderBuffer> bindingTableRing[RingDepth];
+        uint64_t bindingTableRingSize[RingDepth] = {};
+        std::unique_ptr<RenderBuffer> lightsRing[RingDepth];
+        uint64_t lightsRingSize[RingDepth] = {};
+        uint32_t ringIndex = 0;
+        bool interleavedDirty = true;
+        bool setsCreated = false;
+
+        // The trace, once a second.
+        std::chrono::steady_clock::time_point lastTrace{};
+        std::chrono::steady_clock::duration buildTime{};
+        uint32_t buildFrames = 0;
+        uint32_t lastBlasCount = 0;
+        uint32_t lastInstanceCount = 0;
+        uint32_t framesTraced = 0;
+
+        std::unique_ptr<RenderBuffer> &ringSlot(std::unique_ptr<RenderBuffer> *ring, uint64_t *sizes, uint64_t size, RenderBufferFlags flags);
+        void traceBuild();
     };
 };
