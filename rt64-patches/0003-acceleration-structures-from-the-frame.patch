diff --git a/src/shaders/Raytracing.hlsl b/src/shaders/Raytracing.hlsl
new file mode 100644
index 0000000..0dbadcc
--- /dev/null
+++ b/src/shaders/Raytracing.hlsl
@@ -0,0 +1,198 @@
+//
+// RT64, the renderer's patch series (OoT: Recompiled), patch 0003.
+//
+// THE RAY TRACING LIBRARY: every ray generation, miss and hit shader the pipeline names, in one
+// file, compiled once as a DXIL library. The shader cache (rt64_raytracing_shader_cache.cpp)
+// imports these symbols by name and builds the two hit groups from them, and the framebuffer
+// renderer dispatches the five ray generation entries in the order it always has: primary,
+// direct, indirect, reflection, refraction.
+//
+// PHASE 53 IS THE PRIMARY RAY AND NOTHING ELSE. It walks the acceleration structures the frame
+// built and writes what it hit into the buffers every later pass reads: the hit distance (the
+// depth view draws it), the world position, the geometric normal, the instance, the view
+// direction. The diffuse buffer takes the raster color of the pixel for the passes that come.
+// The pinned composite LIGHTS that buffer, and no pass writes a light yet, so the final view is
+// black at this phase and the phase is judged in the distance view; phase 54 composites into the
+// raster output instead. Every other buffer is written to zero so the composite and the filters
+// have defined inputs. The four other ray generation shaders exist so the binding table has
+// their records and return at once; the passes fill them in from phase 54.
+//
+// Bindings are the renderer's own (FbRendererCommon.hlsli, FbRendererRT.hlsli): descriptor set
+// 0 is the common set with the scene structure and every output, sets 1 and 2 the texture
+// cache, set 3 the framebuffer's own background color and depth.
+//
+
+#include "Color.hlsli"
+#include "FbRendererCommon.hlsli"
+#include "FbRendererRT.hlsli"
+
+// The instance masks the renderer assigns (rt64_common.h): the same three bits, by the same names.
+static const uint DepthRayQueryMask = 0x1;
+static const uint NoDepthRayQueryMask = 0x2;
+static const uint ShadowCatcherRayQueryMask = 0x4;
+
+struct SurfacePayload {
+    float hitDistance;      // RayTCurrent() at the closest hit, 0 on a miss
+    int instanceId;         // InstanceID(), which is the frame's instance draw call index, -1 on a miss
+    float3 hitNormal;       // the triangle's geometric normal, facing the ray
+};
+
+struct ShadowPayload {
+    float visibility;       // 1 when the ray escaped, 0 when something stood in the way
+};
+
+// The eye, from the inverse view matrix. The parameter block is written by hlslpp on the CPU
+// with row vectors, so its translation is the fourth row there; HLSL packs the same bytes as a
+// column major matrix, which reads that row as the fourth column.
+float3 eyePosition() {
+    return float3(RtParams.viewI[0][3], RtParams.viewI[1][3], RtParams.viewI[2][3]);
+}
+
+// A pinhole ray for a pixel of the traced viewport. cameraU, cameraV and cameraW are the
+// renderer's own (rt64_framebuffer_renderer.cpp, updateRaytracingScene): W points down the view
+// for the focal distance, U and V span the half width and the half height of the view at that
+// distance. U is scaled by the aspect ratio here because the renderer leaves it square.
+bool primaryRay(uint2 launchIndex, out float3 origin, out float3 direction) {
+    const float2 viewportOrigin = RtParams.viewport.xy;
+    const float2 viewportSize = RtParams.viewport.zw;
+    const float2 pixel = float2(launchIndex) + 0.5f - viewportOrigin;
+    if (any(pixel < 0.0f) || any(pixel >= viewportSize)) {
+        origin = 0.0f;
+        direction = 0.0f;
+        return false;
+    }
+
+    float2 d = (pixel / viewportSize) * 2.0f - 1.0f;
+    d.x *= viewportSize.x / viewportSize.y;
+    d.y = -d.y;
+    origin = eyePosition();
+    direction = normalize(RtParams.cameraW.xyz + RtParams.cameraU.xyz * d.x + RtParams.cameraV.xyz * d.y);
+    return true;
+}
+
+void clearOutputs(uint2 launchIndex) {
+    gViewDirection[launchIndex] = 0.0f;
+    gShadingPosition[launchIndex] = 0.0f;
+    gShadingNormal[launchIndex] = 0.0f;
+    gShadingSpecular[launchIndex] = 0.0f;
+    gDiffuse[launchIndex] = 0.0f;
+    gInstanceId[launchIndex] = -1;
+    gDirectLightAccum[launchIndex] = 0.0f;
+    gIndirectLightAccum[launchIndex] = 0.0f;
+    gReflection[launchIndex] = 0.0f;
+    gRefraction[launchIndex] = 0.0f;
+    gTransparent[launchIndex] = 0.0f;
+    gFlow[launchIndex] = 0.0f;
+    gReactiveMask[launchIndex] = 0.0f;
+    gLockMask[launchIndex] = 0.0f;
+    gNormalRoughness[launchIndex] = 0.0f;
+    gDepth[launchIndex] = 0.0f;
+}
+
+[shader("raygeneration")]
+void PrimaryRayGen() {
+    const uint2 launchIndex = DispatchRaysIndex().xy;
+    clearOutputs(launchIndex);
+
+    // The raster color of this pixel, for the passes that come: the composite converts linear
+    // to sRGB, so the color goes in linear. Alpha zero tells it there is no lighting to apply.
+    const float3 raster = gBackgroundColor.Load(int3(launchIndex, 0)).rgb;
+    gDiffuse[launchIndex] = float4(SrgbToLinear(raster), 0.0f);
+
+    float3 origin;
+    float3 direction;
+    if (!primaryRay(launchIndex, origin, direction)) {
+        return;
+    }
+
+    RayDesc ray;
+    ray.Origin = origin;
+    ray.Direction = direction;
+    ray.TMin = max(RtParams.nearDist, 1.0f);
+    ray.TMax = RtParams.farDist * 4.0f;
+
+    SurfacePayload payload;
+    payload.hitDistance = 0.0f;
+    payload.instanceId = -1;
+    payload.hitNormal = 0.0f;
+    // Only the instances that take part in depth (rt64_common.h, DepthRayQueryMask): a draw
+    // call with depth test and write both off is the game painting a backdrop, and this game
+    // draws its sky as a box around the eye that way, which would otherwise stand in front of
+    // every ray. The no-depth instances are the background passes' concern.
+    TraceRay(SceneBVH, RAY_FLAG_NONE, DepthRayQueryMask, 0, 0, 0, ray, payload);
+
+    gViewDirection[launchIndex] = float4(direction, 0.0f);
+    if (payload.instanceId >= 0) {
+        const float3 hitPosition = origin + direction * payload.hitDistance;
+        gShadingPosition[launchIndex] = float4(hitPosition, 1.0f);
+        gShadingNormal[launchIndex] = float4(payload.hitNormal, 0.0f);
+        gNormalRoughness[launchIndex] = float4(payload.hitNormal, 1.0f);
+        gInstanceId[launchIndex] = payload.instanceId;
+
+        // The depth view draws this as gray, so it is the hit distance over the far plane: near
+        // is dark, the far plane white, the sky (a miss) stays at zero. The square root, because
+        // the game's far plane is several thousand units and everything a player looks at sits
+        // in the first few hundred, which a linear ramp shows as one shade of black.
+        gDepth[launchIndex] = sqrt(saturate(payload.hitDistance / RtParams.farDist));
+    }
+}
+
+// The four passes that arrive with phases 54 to 56. Their records exist in the binding table
+// from the start, so dispatching them is already the shape it will keep.
+[shader("raygeneration")]
+void DirectRayGen() { }
+
+[shader("raygeneration")]
+void IndirectRayGen() { }
+
+[shader("raygeneration")]
+void ReflectionRayGen() { }
+
+[shader("raygeneration")]
+void RefractionRayGen() { }
+
+[shader("closesthit")]
+void SurfaceClosestHit(inout SurfacePayload payload, in BuiltInTriangleIntersectionAttributes attributes) {
+    payload.hitDistance = RayTCurrent();
+    payload.instanceId = int(InstanceID());
+
+    // The triangle's own normal from the world positions the vertex processor wrote, found
+    // through the instance's index range: every instance is one draw call, its indices start
+    // where the renderer says (instanceRenderIndices), and the primitive index counts from there.
+    const uint faceStart = instanceRenderIndices[InstanceID()].faceIndicesStart;
+    const uint3 indices = indexBuffer.Load3((faceStart + PrimitiveIndex() * 3) * 4);
+    const float3 p0 = asfloat(posBuffer.Load3(indices.x * 16));
+    const float3 p1 = asfloat(posBuffer.Load3(indices.y * 16));
+    const float3 p2 = asfloat(posBuffer.Load3(indices.z * 16));
+    float3 normal = cross(p1 - p0, p2 - p0);
+    const float length2 = dot(normal, normal);
+    normal = (length2 > 0.0f) ? (normal * rsqrt(length2)) : float3(0.0f, 1.0f, 0.0f);
+    if (dot(normal, WorldRayDirection()) > 0.0f) {
+        normal = -normal;
+    }
+
+    payload.hitNormal = normal;
+}
+
+[shader("anyhit")]
+void SurfaceAnyHit(inout SurfacePayload payload, in BuiltInTriangleIntersectionAttributes attributes) {
+    // Every surface is solid until the alpha test arrives with the shading (phase 54).
+}
+
+[shader("miss")]
+void SurfaceMiss(inout SurfacePayload payload) {
+    payload.hitDistance = 0.0f;
+    payload.instanceId = -1;
+    payload.hitNormal = 0.0f;
+}
+
+[shader("anyhit")]
+void ShadowAnyHit(inout ShadowPayload payload, in BuiltInTriangleIntersectionAttributes attributes) {
+    payload.visibility = 0.0f;
+    AcceptHitAndEndSearch();
+}
+
+[shader("miss")]
+void ShadowMiss(inout ShadowPayload payload) {
+    payload.visibility = 1.0f;
+}
