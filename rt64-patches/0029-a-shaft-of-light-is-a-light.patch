 // grazing angle to a torch a few steps away (2026-09-24, the bands across the Deku Tree floor).
 static const float LocalBlockerSkip = 10.0f;   // world units; Link is about 60
 
+// A BEAM (patch 0029): a shaft of light the game draws, found by its shape on the CPU
+// (rt64_framebuffer_renderer.cpp, beamFromDraw) and handed over in the light list with this group
+// bit. It is not a point: it is a cylinder of light falling down its own axis, so it lights what
+// stands INSIDE the shaft, from the direction the shaft falls, and nothing outside it. Its fields,
+// named for a point light's: position the top of the shaft, direction down it, the length in the
+// exponent, the radius at the top in the point radius and at the bottom in the spot's maximum,
+// and the share of the radius its edge fades across in the spot's falloff.
+static const uint BeamLightBit = 8u;
+static const float BeamLandingReach = 1.3f;     // past its drawn end a shaft still lands, fading out by this share of its length
+static const float BeamClearanceShare = 0.15f;  // the top of a shaft sits in the hole or the window it comes through; its last share is not traced
+static const float BeamSpread = 0.04f;          // how far a beam's shadow rays lean from the shaft's axis, so its shadows soften
+
+// The light a beam gives a surface, shadowed back up the shaft, and the same unblocked.
+void beamLight(PointLight light, float3 position, float3 normal, float biasBase, uint2 launchIndex, uint lightIndex, uint lightSamples,
+               inout float3 sum, inout float3 sumUnblocked) {
+    const float3 axis = light.direction;
+    const float3 fromTop = position - light.position;
+    const float along = dot(fromTop, axis);
+    const float beamLength = light.attenuationExponent;
+    if ((along <= 0.0f) || (along >= beamLength * BeamLandingReach)) {
+        return;
+    }
+
+    const float radialDistance = length(fromTop - axis * along);
+    const float beamRadius = lerp(light.pointRadius, light.spotMaxCosine, saturate(along / beamLength));
+    if (radialDistance >= beamRadius) {
+        return;
+    }
+
+    const float3 toLight = -axis;
+    const float ndl = saturate(dot(normal, toLight));
+    if (ndl <= 0.0f) {
+        return;
+    }
+
+    const float edge = 1.0f - smoothstep(beamRadius * (1.0f - light.spotFalloffCosine), beamRadius, radialDistance);
+    const float landing = 1.0f - smoothstep(beamLength, beamLength * BeamLandingReach, along);
+    const float weight = edge * landing * ndl;
+    if (weight <= 0.0f) {
+        return;
+    }
+
+    // Straight back up the shaft, each ray leaning a little from its axis, to the last stretch
+    // before the shaft's top: what stands in the shaft above a surface shadows it.
+    float3 tangent;
+    float3 bitangent;
+    tangentFrame(toLight, tangent, bitangent);
+    const float3 shadowOrigin = position + normal * (biasBase * (1.0f + 2.0f / max(ndl, 0.25f)));
+    const float tMax = max(along * (1.0f - BeamClearanceShare), 0.0f);
+    float hitDistance;
+    float blocked = 0.0f;
+    for (uint ls = 0; ls < lightSamples; ls++) {
+        const float3 noise = getBlueNoise(gBlueNoise, launchIndex, FrParams.frameCount + 17u + ls * 31u + lightIndex * 7u);
+        const float angle = 6.28318531f * noise.x;
+        const float spread = sqrt(noise.y) * BeamSpread;
+        const float3 rayDirection = normalize(toLight + tangent * (spread * cos(angle)) + bitangent * (spread * sin(angle)));
+        const float sample = (tMax > LocalBlockerSkip)
+            ? traceVisibilityRange(shadowOrigin, rayDirection, LocalBlockerSkip, tMax, hitDistance)
+            : 1.0f;
+        blocked += 1.0f - sample;
+    }
+
+    const float visibility = 1.0f - (blocked / float(lightSamples));
+    sum += light.diffuseColor * (weight * visibility);
+    sumUnblocked += light.diffuseColor * weight;
+}
