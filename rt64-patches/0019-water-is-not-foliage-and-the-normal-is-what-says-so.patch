                             // a draw in the translucent z mode that READS depth and is more than a
                             // sprite is solid, and it casts. The user, 2026-09-30, on that rung:
@@ -1966,7 +1972,7 @@ namespace RT64 {
                         // all the fixes for trees back"). Reading the code did not explain how, so
                         // it is offered as something to observe rather than as a fix.
                         if ((wasTranslucent && solidDraw) &&
-                            ((cutoutRule == 27) || (cutoutRule == 29))) {
+                            ((cutoutRule == 27) || (cutoutRule == 29) || (cutoutRule == 30))) {
                             raytracing.queryMask |= TranslucentRayQueryMask;
                         }
                         if (drawData.extraParams[call.callDesc.callIndex].shadowCatcherFactor > 0.0f) {
