diff --git a/src/shaders/Raytracing.hlsl b/src/shaders/Raytracing.hlsl
--- a/src/shaders/Raytracing.hlsl
+++ b/src/shaders/Raytracing.hlsl
@@ -1455,6 +1455,119 @@ static const float ScatterFadeEnd = 1400.0f;
 static const float SunScatter = 0.0f;          // per world unit of sunlit air
 static const float LightScatter = 0.002f;      // per world unit at a light's center
 
+// DUST IN THE LIGHT (patch 0035, the user, 2026-10-08: "maybe just have particle ambience
+// throughout the air ... And in the shadows, the particles are not shown. So, like, really, really
+// subtle particles that float through light areas only"). Motes hang in the air round the eye, one
+// at most in each cell of a grid, each at its own place in its cell and drifting slowly. A mote
+// shows as a soft speck one to three pixels across, and only where light actually reaches it: a
+// window's or a shaft's light, the sun's under a sky, the game's own lights within their reach,
+// each followed by a shadow ray. In shadow it is not there at all. Only motes in front of the
+// surface the eye sees and within DustRange; the Dust in the light row says how bright
+// (tuneReflection.w, 0 off). The shadow rays are spent only on a mote the eye's ray actually
+// passes, which is a few pixels in a hundred.
+static const float DustCell = 40.0f;          // world units; at most one mote in each
+static const float DustChance = 0.35f;        // the share of cells that hold one
+static const float DustRange = 1000.0f;       // world units from the eye
+static const float DustNear = 20.0f;          // no mote closer to the eye than this
+static const float DustSize = 0.3f;           // a mote's own radius in world units, held between one and three pixels
+static const float DustDrift = 0.3f;          // how far a mote wanders from its place, as a share of its cell
+static const float DustBrightness = 0.6f;     // a fully lit mote at the row's top, as a share of the light on it
+
+uint4 dustHash(uint4 v) {
+    v = v * 1664525u + 1013904223u;
+    v.x += v.y * v.w; v.y += v.z * v.x; v.z += v.x * v.y; v.w += v.y * v.z;
+    v ^= v >> 16u;
+    v.x += v.y * v.w; v.y += v.z * v.x; v.z += v.x * v.y; v.w += v.y * v.z;
+    return v;
+}
+
+// The light reaching a point in the air, from every light that could show a mote there.
+float3 dustLightAt(float3 p, uint2 launchIndex) {
+    float3 local = 0.0f;
+    float3 unused = 0.0f;
+    const uint count = min(RtParams.lightsCount, RtParams.maxLights);
+    for (uint i = 0; i < count; i++) {
+        const PointLight light = SceneLights[i];
+        if ((light.groupBits & WindowLightBit) != 0u) {
+            windowLight(light, p, -light.direction, 0.0f, launchIndex, i, 1u, local, unused);
+            continue;
+        }
+
+        if ((light.groupBits & BeamLightBit) != 0u) {
+            beamLight(light, p, -light.direction, 0.0f, launchIndex, i, 1u, local, unused);
+            continue;
+        }
+
+        const float3 toLight = light.position - p;
+        const float distance2 = dot(toLight, toLight);
+        const float radius = light.attenuationRadius * RtParams.tuneScatter.w;
+        const float radius2 = radius * radius;
+        if ((distance2 <= 0.0f) || (distance2 >= radius2)) {
+            continue;
+        }
+
+        const float distance = sqrt(distance2);
+        const float clearance = ((light.groupBits & 4u) != 0u) ? light.pointRadius : max(light.pointRadius, LightClearance);
+        const float tMax = max(distance - clearance, 0.0f);
+        float hitDistance;
+        const float visibility = (tMax > 1.0f) ? traceVisibilityRange(p, toLight / distance, 0.0f, tMax, hitDistance) : 1.0f;
+        const float core2 = light.attenuationExponent * light.attenuationExponent;
+        local += light.diffuseColor * (lightFalloff(distance2, radius2, core2) * visibility);
+    }
+
+    float3 arrived = local * RtParams.tuneOcclusion.w;
+    if ((RtParams.sunShadows == 1u) && any(RtParams.sunColor.rgb > 0.0f)) {
+        float hitDistance;
+        arrived += RtParams.sunColor.rgb * traceVisibility(p, RtParams.sunDirection.xyz, 1.0e6f, hitDistance);
+    }
+
+    return arrived;
+}
+
+float3 dustInLight(float3 origin, float3 direction, float end, uint2 launchIndex, float strength) {
+    const float range = min(end, DustRange);
+    const float stepLength = DustCell * 0.5f;
+    const uint steps = min(uint(range / stepLength) + 1u, 64u);
+    const float pixelAngle = RtParams.fovRadians / max(RtParams.viewport.w, 1.0f);
+    const float seconds = float(FrParams.frameCount) * (1.0f / 60.0f);
+    int3 lastCell = int3(2147483647, 2147483647, 2147483647);
+    float3 sum = 0.0f;
+    for (uint s = 0; s < steps; s++) {
+        const float3 p = origin + direction * (float(s) * stepLength);
+        const int3 cell = int3(floor(p / DustCell));
+        if (all(cell == lastCell)) {
+            continue;
+        }
+
+        lastCell = cell;
+        const float4 h = float4(dustHash(uint4(uint3(cell), 0x2545F491u))) * (1.0f / 4294967295.0f);
+        if (h.w > DustChance) {
+            continue;
+        }
+
+        const float3 phase = h.xyz * 6.28318531f;
+        const float3 drift = sin(seconds * float3(0.21f, 0.13f, 0.17f) + phase) * (DustCell * DustDrift);
+        const float3 mote = (float3(cell) + 0.2f + h.xyz * 0.6f) * DustCell + drift;
+        const float along = dot(mote - origin, direction);
+        if ((along <= DustNear) || (along >= range)) {
+            continue;
+        }
+
+        const float apart = length(mote - (origin + direction * along));
+        const float size = clamp(DustSize, along * pixelAngle, along * pixelAngle * 3.0f);
+        const float cover = 1.0f - smoothstep(0.0f, size, apart);
+        if (cover <= 0.0f) {
+            continue;
+        }
+
+        const float distanceFade = 1.0f - smoothstep(range * 0.6f, range, along);
+        const float twinkle = 0.5f + 0.5f * frac(h.w * 7.0f);
+        sum += dustLightAt(mote, launchIndex) * (cover * distanceFade * twinkle);
+    }
+
+    return sum * (strength * DustBrightness);
+}
+
 [shader("raygeneration")]
 void ScatterRayGen() {
     const uint2 launchIndex = DispatchRaysIndex().xy;
@@ -1484,7 +1597,8 @@ void ScatterRayGen() {
     const float sunHaze = RtParams.tuneScatter.y;
     const float fadeEnd = max(RtParams.tuneScatter.z, 10.0f);
     const float fadeStart = fadeEnd * 0.35f;
-    if ((lightGlow <= 0.0f) && (sunHaze <= 0.0f)) {
+    const float dust = saturate(RtParams.tuneReflection.w);   // the Dust in the light row (patch 0035)
+    if ((lightGlow <= 0.0f) && (sunHaze <= 0.0f) && (dust <= 0.0f)) {
         gScatter[launchIndex] = 0.0f;
         return;
     }
@@ -1539,6 +1653,11 @@ void ScatterRayGen() {
         }
     }
 
+    // The dust in the light, along the same ray to the same surface (patch 0035).
+    if (dust > 0.0f) {
+        sum += dustInLight(origin, direction, end, launchIndex, dust);
+    }
+
     // No history here (patch 0008): the glow is smooth on its own and follows a moving light
     // (Navi), and a history of it painted a trail behind her.
     gScatter[launchIndex] = float4(sum, 1.0f);
