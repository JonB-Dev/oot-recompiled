+// THE THINGS THAT MOVE THROUGH THE DUST (patch 0037, the user, 2026-10-08: "as Link runs through
+// it ... the dust would be moving along with Link in that direction, like it would be pushed, and
+// then air would kind of flow out behind Link and ... bellow out"; "all things that can receive a
+// shadow or cast a shadow should also interact with the dust"). The program hands over a trail of
+// samples of every actor that moved, in the light list with this group bit (no light, only a
+// position, the motion in world units a second, a reach, and the age in seconds), and every light
+// loop passes them over. A mote near a young sample is carried along with the motion; as the
+// sample ages its wake widens, and the air spills outward from the path and lifts a little, then
+// settles as the sample dies, so a figure running through dust pushes it ahead and leaves it
+// billowing behind. (AirMoverBit itself is declared beside the beams' bit, before the passes
+// that pass over it.)
+static const float MoverLife = 1.0f;          // seconds a trail sample pushes for
+static const float MoverSpreadRate = 1.5f;    // how much wider a wake grows each second, as a share of the reach
+static const float MoverCarry = 0.1f;         // seconds of the motion a mote at the heart of the push is carried
+static const float MoverSpill = 0.05f;        // how far out the air spills behind, per unit a second of the motion
+static const float MoverLift = 0.03f;         // how far up it billows, the same way
+static const float MoverTopSpeed = 400.0f;    // world units a second; anything faster pushes as hard as this
+
+float moverSpread(PointLight light) {
+    return light.attenuationRadius * (1.0f + light.flickerIntensity * MoverSpreadRate);
+}
+
+float3 moverPush(float3 mote, PointLight light) {
+    const float life = saturate(1.0f - light.flickerIntensity / MoverLife);
+    if (life <= 0.0f) {
+        return float3(0.0f, 0.0f, 0.0f);
+    }
+
+    const float spread = moverSpread(light);
+    const float3 r = mote - light.position;
+    const float weight = exp(-dot(r, r) / (spread * spread)) * life * life;
+    const float3 velocity = light.direction;
+    const float rawSpeed = length(velocity);
+    const float speed = min(rawSpeed, MoverTopSpeed);
+    const float3 carried = (rawSpeed > 1.0e-3f) ? (velocity * (speed / rawSpeed)) : float3(0.0f, 0.0f, 0.0f);
+    const float3 side = float3(r.x, 0.0f, r.z);
+    const float sideLength = length(side);
+    const float3 outward = (sideLength > 1.0e-3f) ? (side / sideLength) : float3(0.0f, 0.0f, 0.0f);
+    const float passed = saturate(light.flickerIntensity * 4.0f);   // the spill and the lift come once the mover has gone by
+    return weight * (carried * MoverCarry + outward * (speed * MoverSpill * passed) + float3(0.0f, speed * MoverLift * passed, 0.0f));
+}
