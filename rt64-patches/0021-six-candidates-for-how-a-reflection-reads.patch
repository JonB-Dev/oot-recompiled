                             // is untouched.
                             case 30: solidDraw = otherMode.zCmp() && manyTriangles; break;
+                            // 31 to 35 are rung 30 with one candidate each for how the
+                            // REFLECTION reads, which is a different question from which rays
+                            // see what and is answered in the shader. Classified identically, so
