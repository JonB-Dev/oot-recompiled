+    // Rebuild the native descriptor from the API-independent mesh records retained in
+    // RenderBottomLevelASBuildInfo. RT64 updates world-space vertices every frame.
+    static MTL::PrimitiveAccelerationStructureDescriptor *metalBottomLevelDescriptor(
+        const RenderBottomLevelASMesh *meshes, uint32_t meshCount, bool preferFastBuild) {
+        std::vector<const NS::Object *> geometryObjects;
+        geometryObjects.reserve(meshCount);
+        for (uint32_t i = 0; i < meshCount; i++) {
+            const RenderBottomLevelASMesh &mesh = meshes[i];
+            assert(mesh.vertexFormat == RenderFormat::R32G32B32_FLOAT);
+            assert(mesh.indexCount % 3 == 0);
+            const MetalBuffer *vertices = static_cast<const MetalBuffer *>(mesh.vertexBuffer.ref);
+            const MetalBuffer *indices = static_cast<const MetalBuffer *>(mesh.indexBuffer.ref);
+            assert(vertices != nullptr && indices != nullptr);
+            auto *geometry = MTL::AccelerationStructureTriangleGeometryDescriptor::descriptor();
+            geometry->setVertexBuffer(vertices->mtl);
+            geometry->setVertexBufferOffset(mesh.vertexBuffer.offset);
+            geometry->setVertexFormat(MTL::AttributeFormatFloat3);
+            geometry->setVertexStride(mesh.vertexStride);
+            geometry->setIndexBuffer(indices->mtl);
+            geometry->setIndexBufferOffset(mesh.indexBuffer.offset);
+            geometry->setIndexType(mapIndexFormat(mesh.indexFormat));
+            geometry->setTriangleCount(mesh.indexCount / 3);
+            geometry->setOpaque(mesh.isOpaque);
+            geometryObjects.push_back(geometry);
+        }
+        auto *descriptor = MTL::PrimitiveAccelerationStructureDescriptor::descriptor();
+        descriptor->setGeometryDescriptors(NS::Array::array(geometryObjects.data(), geometryObjects.size()));
+        descriptor->setUsage(preferFastBuild ? MTL::AccelerationStructureUsagePreferFastBuild
+                                             : MTL::AccelerationStructureUsageNone);
+        return descriptor;
+    }
+
+    static MTL::InstanceAccelerationStructureDescriptor *metalTopLevelDescriptor(
+        const RenderTopLevelASInstance *instances, uint32_t instanceCount,
+        const MTL::Buffer *instanceBuffer) {
+        std::vector<const NS::Object *> structures;
+        structures.reserve(instanceCount);
+        for (uint32_t i = 0; i < instanceCount; i++) {
+            const auto *backing = static_cast<const MetalBuffer *>(instances[i].bottomLevelAS.ref);
+            assert(backing != nullptr && backing->accelerationStructure != nullptr);
+            structures.push_back(backing->accelerationStructure);
+        }
+        auto *descriptor = MTL::InstanceAccelerationStructureDescriptor::descriptor();
+        descriptor->setInstancedAccelerationStructures(NS::Array::array(structures.data(), structures.size()));
+        descriptor->setInstanceDescriptorBuffer(instanceBuffer);
+        descriptor->setInstanceDescriptorStride(sizeof(MTL::AccelerationStructureUserIDInstanceDescriptor));
+        descriptor->setInstanceDescriptorType(MTL::AccelerationStructureInstanceDescriptorTypeUserID);
+        descriptor->setInstanceCount(instanceCount);
+        return descriptor;
+    }
