+    RenderPipelineProgram MetalRaytracingPipeline::getProgram(const std::string &name) const {
+        const auto found = programIndices.find(name);
+        assert(found != programIndices.end());
+        return found != programIndices.end() ? RenderPipelineProgram(found->second) : RenderPipelineProgram();
+    }
