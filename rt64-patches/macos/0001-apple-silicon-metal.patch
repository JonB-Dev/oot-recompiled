 namespace plume {
+    // Resources encoded into a command buffer must survive until GPU completion.
+    // Keep Metal's strong references and include encoder status in driver errors.
+    static MTL::CommandBuffer *makeRetainedCommandBuffer(MTL::CommandQueue *queue, const char *label) {
+        auto *descriptor = MTL::CommandBufferDescriptor::alloc()->init();
+        descriptor->setRetainedReferences(true);
+        descriptor->setErrorOptions(MTL::CommandBufferErrorOptionEncoderExecutionStatus);
+        auto *buffer = queue->commandBuffer(descriptor);
+        descriptor->release();
+        buffer->setLabel(NS::String::string(label, NS::UTF8StringEncoding));
+        buffer->addCompletedHandler([](MTL::CommandBuffer *completed) {
+            if (completed->status() != MTL::CommandBufferStatusError) return;
+            auto releasePool = NS::TransferPtr(NS::AutoreleasePool::alloc()->init());
+            const auto *error = completed->error();
+            const auto *details = error && error->userInfo() ? error->userInfo()->description() : nullptr;
+            std::fprintf(stderr, "[metal] command failed: label=%s code=%ld description=%s details=%s\n",
+                completed->label() ? completed->label()->utf8String() : "unlabeled",
+                error ? static_cast<long>(error->code()) : -1L,
+                error ? error->localizedDescription()->utf8String() : "unavailable",
+                details ? details->utf8String() : "unavailable");
+            std::fflush(stderr);
+        });
+        return buffer;
+    }
