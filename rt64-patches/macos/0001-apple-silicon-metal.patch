+    // MetalRaytracingPipeline
+
+    MetalRaytracingPipeline::MetalRaytracingPipeline(const MetalDevice *device,
+        const RenderRaytracingPipelineDesc &desc) : MetalPipeline(device, Type::Raytracing) {
+        if (!device->mtl->supportsRaytracing() || desc.libraries == nullptr ||
+            desc.librariesCount == 0 || desc.pipelineLayout == nullptr) {
+            return;
+        }
+
+        MetalAutoreleasePool releasePool;
+        const char *overrideDirectory = std::getenv("RT64_METAL_RT_SHADER_DIR");
+        std::string shaderDirectory;
+        if (overrideDirectory != nullptr && overrideDirectory[0] != '\0') {
+            shaderDirectory = overrideDirectory;
+        } else {
+            const NS::Bundle *bundle = NS::Bundle::mainBundle();
+            if (bundle == nullptr || bundle->resourcePath() == nullptr) {
+                return;
+            }
+            shaderDirectory = bundle->resourcePath()->utf8String();
+            shaderDirectory += "/rt64-raytracing";
+        }
+
+        struct LoadedFunctions {
+            std::vector<MTL::Library *> libraries;
+            std::unordered_map<std::string, MTL::Function *> functions;
+            ~LoadedFunctions() {
+                for (auto &[name, function] : functions) {
+                    function->release();
+                }
+                for (auto *library : libraries) {
+                    library->release();
+                }
+            }
+        } loaded;
+        auto loadFunction = [&](const std::string &fileName, const std::string &symbol) -> MTL::Function * {
+            const std::string path = shaderDirectory + "/" + fileName + ".metallib";
+            NS::Error *error = nullptr;
+            auto *library = device->mtl->newLibrary(
+                NS::URL::fileURLWithPath(NS::String::string(path.c_str(), NS::UTF8StringEncoding)), &error);
+            if (library == nullptr) {
+                std::fprintf(stderr, "[metal-rt] failed to load %s: %s\n", path.c_str(),
+                    error ? error->localizedDescription()->utf8String() : "no Metal error");
+                return nullptr;
+            }
+            loaded.libraries.push_back(library);
+            auto *function = library->newFunction(NS::String::string(symbol.c_str(), NS::UTF8StringEncoding));
+            if (function == nullptr) {
+                std::fprintf(stderr, "[metal-rt] missing shader function %s\n", symbol.c_str());
+                return nullptr;
+            }
+            loaded.functions.emplace(symbol, function);
+            return function;
+        };
+
+        std::vector<std::string> rayGenerationNames;
+        std::vector<MTL::Function *> visibleFunctions;
+        std::unordered_map<std::string, uint64_t> visibleHandles;
+        for (uint32_t libraryIndex = 0; libraryIndex < desc.librariesCount; libraryIndex++) {
+            const auto &library = desc.libraries[libraryIndex];
+            for (uint32_t i = 0; i < library.symbolsCount; i++) {
+                const auto &symbol = library.symbols[i];
+                if (symbol.importName == nullptr) {
+                    return;
+                }
+                const std::string importName(symbol.importName);
+                auto *function = loadFunction(importName, importName);
+                if (function == nullptr) {
+                    return;
+                }
+                const std::string programName = symbol.exportName ? symbol.exportName : symbol.importName;
+                if (!programIndices.emplace(programName, uint32_t(programIdentifiers.size())).second) {
+                    return;
+                }
+                MetalIRShaderIdentifier identifier;
+                if (symbol.type == RenderRaytracingPipelineLibrarySymbolType::RAYGEN) {
+                    rayGenerationNames.push_back(importName);
+                } else {
+                    visibleFunctions.push_back(function);
+                    identifier.shaderHandle = visibleFunctions.size(); // Visible table slot zero is reserved.
+                    visibleHandles.emplace(importName, identifier.shaderHandle);
+                }
+                programIdentifiers.push_back(identifier);
+            }
+        }
+        for (uint32_t i = 0; i < desc.hitGroupsCount; i++) {
+            const auto &group = desc.hitGroups[i];
+            if (group.hitGroupName == nullptr ||
+                (group.closestHitName != nullptr && loaded.functions.count(group.closestHitName) == 0) ||
+                (group.anyHitName != nullptr && loaded.functions.count(group.anyHitName) == 0) ||
+                (group.intersectionName != nullptr && loaded.functions.count(group.intersectionName) == 0)) {
+                return;
+            }
+            MetalIRShaderIdentifier identifier;
+            if (group.closestHitName != nullptr) {
+                const auto found = visibleHandles.find(group.closestHitName);
+                if (found == visibleHandles.end()) return;
+                identifier.shaderHandle = found->second;
+            }
+            if (group.anyHitName != nullptr) {
+                const auto found = visibleHandles.find(group.anyHitName);
+                if (found == visibleHandles.end()) return;
+                identifier.intersectionShaderHandle = found->second;
+            }
+            if (!programIndices.emplace(group.hitGroupName, uint32_t(programIdentifiers.size())).second) {
+                return;
+            }
+            programIdentifiers.push_back(identifier);
+        }
+        auto *intersection = loadFunction("IndirectTriangleIntersection",
+            "irconverter.wrapper.intersection.function.triangle");
+        if (intersection == nullptr || rayGenerationNames.empty()) {
+            return;
+        }
+
+        std::vector<const NS::Object *> linkedObjects;
+        linkedObjects.reserve(visibleFunctions.size() + 1);
+        for (auto *function : visibleFunctions) {
+            linkedObjects.push_back(function);
+        }
+        linkedObjects.push_back(intersection);
+        auto *linked = MTL::LinkedFunctions::linkedFunctions();
+        linked->setFunctions(NS::Array::array(linkedObjects.data(), linkedObjects.size()));
+
+        for (const auto &name : rayGenerationNames) {
+            auto *descriptor = MTL::ComputePipelineDescriptor::alloc()->init();
+            descriptor->setComputeFunction(loaded.functions.at(name));
+            descriptor->setLinkedFunctions(linked);
+            // Converted DXR traversal invokes nested intersection and hit wrappers.
+            // Metal defaults to one frame, which validation rejects on the first ray.
+            descriptor->setMaxCallStackDepth(8);
+            descriptor->setLabel(NS::String::string(name.c_str(), NS::UTF8StringEncoding));
+            NS::Error *error = nullptr;
+            RayGeneration state;
+            state.name = name;
+            state.pipeline = device->mtl->newComputePipelineState(
+                descriptor, MTL::PipelineOptionNone, nullptr, &error);
+            descriptor->release();
+            if (state.pipeline == nullptr) {
+                std::fprintf(stderr, "[metal-rt] failed to link %s: %s\n", name.c_str(),
+                    error ? error->localizedDescription()->utf8String() : "no Metal error");
+                return;
+            }
+            rayGenerations.push_back(state);
+            auto &built = rayGenerations.back();
+            auto *visibleDesc = MTL::VisibleFunctionTableDescriptor::visibleFunctionTableDescriptor();
+            visibleDesc->setFunctionCount(visibleFunctions.size() + 1);
+            built.visibleTable = built.pipeline->newVisibleFunctionTable(visibleDesc);
+            auto *intersectionDesc = MTL::IntersectionFunctionTableDescriptor::intersectionFunctionTableDescriptor();
+            intersectionDesc->setFunctionCount(1);
+            built.intersectionTable = built.pipeline->newIntersectionFunctionTable(intersectionDesc);
+            if (built.visibleTable == nullptr || built.intersectionTable == nullptr) {
+                return;
+            }
+            for (uint32_t i = 0; i < visibleFunctions.size(); i++) {
+                auto *handle = built.pipeline->functionHandle(visibleFunctions[i]);
+                if (handle == nullptr) {
+                    return;
+                }
+                built.visibleTable->setFunction(handle, i + 1); // Zero means no shader.
+            }
+            auto *handle = built.pipeline->functionHandle(intersection);
+            if (handle == nullptr) {
+                return;
+            }
+            built.intersectionTable->setFunction(handle, 0);
+        }
+        valid = true;
+    }
+
+    MetalRaytracingPipeline::~MetalRaytracingPipeline() {
+        MetalAutoreleasePool releasePool;
+        for (auto &state : rayGenerations) {
+            if (state.intersectionTable != nullptr) state.intersectionTable->release();
+            if (state.visibleTable != nullptr) state.visibleTable->release();
+            if (state.pipeline != nullptr) state.pipeline->release();
+        }
+    }
