+                                                 std::clamp(rtConfig.windowMoveZ, -1000.0f, 1000.0f), 0.0f);
         rtParams.tuneScatter = hlslpp::float4(rtConfig.lightGlow, rtConfig.sunHaze, rtConfig.hazeRange, rtConfig.lightReach);
         rtParams.tuneFade = hlslpp::float4(rtConfig.fogFade, rtConfig.distanceFade, rtConfig.shadowSoftness, rtConfig.historyBlend);
         // y the Darkness row, z the Shadow rays row: how many samples over the sun's disc every
diff --git a/src/render/rt64_raytracing_resources.h b/src/render/rt64_raytracing_resources.h
--- a/src/render/rt64_raytracing_resources.h
+++ b/src/render/rt64_raytracing_resources.h
