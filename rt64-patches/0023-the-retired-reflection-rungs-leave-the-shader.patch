-                if (RtParams.tuneExperiment.x != 33.0f) {
-                    return frame;
-                }
+                return frame;
             }
         }
     }
 
-    // D (34): the estimate is the surface's lit VERTEX color times a constant standing in
-    // for its texture's average, so for a BLACK surface it hands back a pale color. That is
-    // the shape of "black turns white in reflections no matter the time of day", and it
-    // needs no inversion to produce. Here the fog's color stands in instead.
-    if (RtParams.tuneExperiment.x == 34.0f) {
-        return fogColorOf(pixelInstance);
-    }
+    // THE REFLECTION CANDIDATES A, C AND D LEFT THIS FUNCTION (patch 0023). They were rungs 31,
+    // 33 and 34 of patch 0021, the reflections were removed on 2026-09-30, and the rungs were
+    // renumbered for the shade work of patch 0022 while these tests stayed. This function is the
+    // BOUNCE pass's as well as the reflection pass's, so "Shade: local after knee" (31) also
+    // took the bounce's light from the frame times the direct light, and "Shade: both" (33) also
+    // stopped the bounce reading the frame: two rungs that each changed a second, unnamed thing.
     return estimate;
 }
 
