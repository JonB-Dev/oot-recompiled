         float4 tuneWind;         // patch 0036: x and y the way the outdoor wind blows over the ground (world x and z), z its speed in world units a second, w its gusts (0 none)
-        float4 tuneAmbience;     // patch 0037: x where the ambience's long fade with distance ends, in world units; patch 0038: y and z the indoor and the outdoor median mote radius in world units; w spare
+        float4 tuneAmbience;     // patch 0037: x where the ambience's long fade with distance ends, in world units (indoors since 0041); patch 0038: y and z the indoor and the outdoor median mote radius in world units; patch 0041: w the outdoor fade's end
+        // (patch 0041: a tuneWind direction of nothing asks for the varied wind)
         // (patch 0038: tuneDust.x and z are now motes to a cell, 0 to 8, no longer a share of cells)
 
