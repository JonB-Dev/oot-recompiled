diff --git a/src/hle/rt64_present_queue.cpp b/src/hle/rt64_present_queue.cpp
--- a/src/hle/rt64_present_queue.cpp
+++ b/src/hle/rt64_present_queue.cpp
@@ -350,6 +350,56 @@ namespace RT64 {
                 if (renderParams.texture != nullptr) {
                     commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(renderParams.texture, RenderTextureLayout::SHADER_READ));
                     viRenderer->render(renderParams);
+
+                    // THE VIDEO RECORDER'S PICTURE (OoT: Recompiled, patch 0053). The same VI pass
+                    // drawn a second time, into a target of the recording's size rather than the
+                    // window's, with no panel inset: the picture the window shows, at any size,
+                    // and nothing of the program's own interface in it.
+                    RenderHookPictureSize *pictureSizeHook = GetRenderHookPictureSize();
+                    RenderHookPicture *pictureHook = GetRenderHookPicture();
+                    uint32_t pictureWidth = 0;
+                    uint32_t pictureHeight = 0;
+                    if ((pictureSizeHook != nullptr) && (pictureHook != nullptr) &&
+                        pictureSizeHook(ext.swapChain->getWidth(), ext.swapChain->getHeight(), &pictureWidth, &pictureHeight) &&
+                        (pictureWidth > 0) && (pictureHeight > 0))
+                    {
+                        if ((pictureTexture == nullptr) || (pictureTextureWidth != pictureWidth) || (pictureTextureHeight != pictureHeight)) {
+                            pictureFramebuffer.reset();
+                            pictureTexture.reset();
+                            RenderClearValue clearValue = RenderClearValue::Color(RenderColor(), RenderFormat::B8G8R8A8_UNORM);
+                            pictureTexture = ext.device->createTexture(RenderTextureDesc::ColorTarget(pictureWidth, pictureHeight, RenderFormat::B8G8R8A8_UNORM, RenderMultisampling(), &clearValue));
+                            const RenderTexture *pictureTarget = pictureTexture.get();
+                            pictureFramebuffer = ext.device->createFramebuffer(RenderFramebufferDesc(&pictureTarget, 1));
+                            pictureTextureWidth = pictureWidth;
+                            pictureTextureHeight = pictureHeight;
+                        }
+
+                        commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(pictureTexture.get(), RenderTextureLayout::COLOR_WRITE));
+                        commandList->setFramebuffer(pictureFramebuffer.get());
+                        commandList->clearColor();
+
+                        VIRenderer::RenderParams pictureParams = renderParams;
+                        pictureParams.insetLeft = 0;
+                        pictureParams.insetRight = 0;
+                        pictureParams.targetWidth = pictureWidth;
+                        pictureParams.targetHeight = pictureHeight;
+                        viRenderer->render(pictureParams);
+
+                        commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(pictureTexture.get(), RenderTextureLayout::COPY_SOURCE));
+                        pictureHook(commandList, pictureTexture.get(), pictureWidth, pictureHeight);
+
+                        // Back to the window for whatever is drawn over the picture next.
+                        commandList->setFramebuffer(swapChainFramebuffer);
+                        pictureIdlePresents = 0;
+                    }
+                    else if ((pictureTexture != nullptr) && (++pictureIdlePresents > 600)) {
+                        // Ten seconds at sixty without a picture wanted: the recording is over,
+                        // and a target that may be the size of a 4K frame is given back.
+                        pictureFramebuffer.reset();
+                        pictureTexture.reset();
+                        pictureTextureWidth = 0;
+                        pictureTextureHeight = 0;
+                    }
                 }
 
                 RenderHookDraw *drawHook = GetRenderHookDraw();
