@@ -87,6 +87,10 @@ namespace RT64 {
     }
 
     void VIRenderer::getViewportAndScissor(const RenderSwapChain *swapChain, const VI &vi, hlslpp::float2 resolutionScale, uint32_t downsamplingScale, bool removeBlackBorders, RenderViewport &viewport, RenderRect &scissor, uint32_t insetLeft, uint32_t insetRight) {
+        getViewportAndScissor(swapChain, vi, resolutionScale, downsamplingScale, removeBlackBorders, viewport, scissor, insetLeft, insetRight, 0, 0);
+    }
+
+    void VIRenderer::getViewportAndScissor(const RenderSwapChain *swapChain, const VI &vi, hlslpp::float2 resolutionScale, uint32_t downsamplingScale, bool removeBlackBorders, RenderViewport &viewport, RenderRect &scissor, uint32_t insetLeft, uint32_t insetRight, uint32_t targetWidth, uint32_t targetHeight) {
         // We define three different coordinate spaces to work with to translate the VI parameters into the Window.
         //
         // VideoSD: This corresponds to the SD TV Scanline space, which is what the VI natively works on.
@@ -102,7 +106,12 @@ namespace RT64 {
         // specified by the VI.
         const hlslpp::float2 sdSize = removeBlackBorders ? hlslpp::float2(vi.fbSize()) : hlslpp::float2(320.0f, 240.0f);
         const hlslpp::float2 hdSize = computeHDSize(sdSize, resolutionScale, downsamplingScale);
-        const hlslpp::float2 windowSize = { float(swapChain->getWidth()), float(swapChain->getHeight()) };
+        // THE TARGET IS THE SWAP CHAIN UNLESS ONE IS NAMED (OoT: Recompiled, patch 0053). The video
+        // recorder draws the same picture a second time into a target of its own size, which may be
+        // larger than the window: everything below is relative to this one size, so naming it is
+        // the whole change.
+        const bool namedTarget = (targetWidth > 0) && (targetHeight > 0);
+        const hlslpp::float2 windowSize = namedTarget ? hlslpp::float2(float(targetWidth), float(targetHeight)) : hlslpp::float2(float(swapChain->getWidth()), float(swapChain->getHeight()));
 
         // Query the VI for the current rendering area.
         hlslpp::float4 viViewRect = vi.viewRectangle() * sdSize.xyxy;
