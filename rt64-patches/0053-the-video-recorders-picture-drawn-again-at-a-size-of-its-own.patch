+        getViewportAndScissor(p.swapChain, *p.vi, p.resolutionScale, p.downsamplingScale, p.removeBlackBorders, viewport, scissor, p.insetLeft, p.insetRight, p.targetWidth, p.targetHeight);
         p.commandList->setViewports(viewport);
